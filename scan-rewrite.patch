@@ -0,0 +1,39 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  پروفایل Publish به‌صورت ClickOnce برای توزیع Agent.
+  استفاده (روی ویندوز):
+    Visual Studio → راست‌کلیک پروژه Agent → Publish → انتخاب پروفایل ClickOnce
+    یا:  msbuild ScanSystem.Agent.csproj /t:Publish /p:Configuration=Release /p:PublishProfile=ClickOnce
+  خروجی در publish/client قرار می‌گیرد؛ فایل ScanSystem.Agent.application را
+  روی وب‌سرور/شبکه داخلی قرار دهید تا کلاینت‌ها نصب و آپدیت خودکار بگیرند.
+-->
+<Project>
+  <PropertyGroup>
+    <PublishProtocol>ClickOnce</PublishProtocol>
+    <PublishDir>..\..\publish\client</PublishDir>
+    <PublishUrl>..\..\publish\client</PublishUrl>
+    <InstallUrl>\\YOUR-SERVER\share\ScanSystemAgent\</InstallUrl>
+    <InstallFrom>Web</InstallFrom>
+    <CreateDesktopShortcut>true</CreateDesktopShortcut>
+    <CreateWebPageOnPublish>true</CreateWebPageOnPublish>
+    <WebPage>publish.htm</WebPage>
+    <UpdateEnabled>true</UpdateEnabled>
+    <UpdateMode>Foreground</UpdateMode>
+    <UpdateInterval>7</UpdateInterval>
+    <UpdateIntervalUnits>Days</UpdateIntervalUnits>
+    <UpdatePeriodically>false</UpdatePeriodically>
+    <UpdateRequired>false</UpdateRequired>
+    <MapFileExtensions>true</MapFileExtensions>
+    <ProductName>ScanSystem Agent</ProductName>
+    <PublisherName>ScanSystem</PublisherName>
+    <ApplicationRevision>0</ApplicationRevision>
+    <ApplicationVersion>1.0.0.%2a</ApplicationVersion>
+    <IsWebBootstrapper>true</IsWebBootstrapper>
+    <BootstrapperEnabled>true</BootstrapperEnabled>
+    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

@using System.Data
@using Microsoft.AspNetCore.SignalR.Client
@using ScanSystem.Shared
@using ScanSystem.Web.Services
@implements IAsyncDisposable
@inject IScanService ScanService
@inject Microsoft.JSInterop.IJSRuntime JS

@*
    گالری اسکن‌ها — متصل به جدول اصلی پروژه (PDDImage.ImagesTable):
    گروه‌ها (ارتباط 1 به n از طریق ImageGroupID)، انتخاب چندتایی،
    «بارگذاری بیشتر» و پنل عملیات تمام‌صفحه (چرخش / گروه / دانلود / حذف).
*@

<div class="sa-card">
    <div class="sa-card-header">
        <span class="sa-card-title"><i class="bi bi-images"></i> گالری اسکن‌ها</span>
        <span class="sa-count-badge">@galleryTotal تصویر</span>
    </div>
    <div class="sa-card-body">
        <!-- نوار گروه‌ها -->
        <div class="sa-group-bar">
            <span class="sa-group-chip @(activeGroupId == null ? "active" : "")" @onclick="() => SelectGroup(null)">
                <i class="bi bi-grid"></i> همه
            </span>
            @if (groups != null)
            {
                @foreach (DataRow g in groups.Rows)
                {
                    var gid = DecVal(g, "ID");
                    <span class="sa-group-chip @(activeGroupId == gid ? "active" : "")" @onclick="() => SelectGroup(gid)">
                        <i class="bi bi-folder2"></i> @Str(g, "ImageGroupName")
                    </span>
                }
            }
            <span class="sa-group-chip add" @onclick="CreateGroup">
                <i class="bi bi-plus-lg"></i> گروه
            </span>
        </div>

        @if (galleryLoading && (gallery == null || gallery.Rows.Count == 0))
        {
            <div class="sa-empty">
                <div class="spinner-border text-primary"></div>
                <p>در حال بارگذاری...</p>
            </div>
        }
        else if (gallery == null || gallery.Rows.Count == 0)
        {
            <div class="sa-empty">
                <i class="bi bi-inbox"></i>
                <p>هنوز تصویری ثبت نشده است.</p>
            </div>
        }
        else
        {
            <div class="sa-gallery-grid">
                @foreach (DataRow row in gallery.Rows)
                {
                    var imgId = DecVal(row, "Id");
                    var selected = selectedImages.Contains(imgId);
                    <div class="sa-tile@(selected ? " selected" : "")" @key="imgId" @onclick="() => OpenImage(imgId)">
                        <input type="checkbox" class="sa-tile-check" checked="@selected"
                               @onclick:stopPropagation="true" @onclick="() => ToggleSelect(imgId)" />
                        <span class="sa-tile-badge">@(string.IsNullOrEmpty(Str(row, "GroupName")) ? "—" : Str(row, "GroupName"))</span>
                        <img src="@GetThumbnailSrc(imgId)" loading="lazy" alt="@Str(row, "FileName")"
                             onerror="this.src='data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxMDAiIGhlaWdodD0iMTAwIj48cmVjdCB3aWR0aD0iMTAwJSIgaGVpZ2h0PSIxMDAlIiBmaWxsPSIjZjFmM2Y1Ii8+PHRleHQgeD0iNTAlIiB5PSI1MCUiIGZvbnQtc2l6ZT0iMTIiIHRleHQtYW5jaG9yPSJtaWRkbGUiIGZpbGw9IiM2Yjc1N2QiPuaYpeeahOGJtOacjeWLmzwvdGV4dD48L3N2Zz4='\" />
                        <div class="sa-tile-info">
                            @Str(row, "FileName") • @Str(row, "Date") @Str(row, "ScanTime")
                        </div>
                    </div>
                }
            </div>

            <div class="sa-load-more-wrap">
                @if (galleryLoading)
                {
                    <div class="spinner-border text-primary"></div>
                }
                else if (gallery.Rows.Count < galleryTotal)
                {
                    <button class="sa-btn sa-btn-ghost" @onclick="LoadMoreGallery">
                        <i class="bi bi-arrow-down-circle"></i> بارگذاری بیشتر (@(galleryTotal - gallery.Rows.Count))
                    </button>
                }
            </div>
        }

        @if (selectedImages.Count > 0)
        {
            <div class="sa-selection-bar">
                <span class="small text-muted">@selectedImages.Count انتخاب شده:</span>
                <select class="form-select form-select-sm" style="width:auto" @onchange="AssignSelectedToGroup">
                    <option value="">افزودن به گروه...</option>
                    @if (groups != null)
                    {
                        @foreach (DataRow g in groups.Rows)
                        {
                            <option value="@Str(g, "ImageGroupName")">@Str(g, "ImageGroupName")</option>
                        }
                    }
                </select>
                <button class="sa-btn sa-btn-ghost text-danger" @onclick="DeleteSelectedImages">
                    <i class="bi bi-trash"></i> حذف
                </button>
                <button class="sa-btn sa-btn-ghost" @onclick="() => selectedImages.Clear()">
                    لغو
                </button>
            </div>
        }
    </div>
</div>

<!-- مودال پیش‌نمایش / ویرایش تصویر -->
@if (modalImageId.HasValue)
{
    <div class="sa-fullscreen" tabindex="0" @onkeydown="HandleModalKey">
        <aside class="sa-action-panel" dir="rtl" aria-label="عملیات تصویر">
            <button type="button" class="sa-close-button" title="بستن" @onclick="CloseModal">
                <i class="bi bi-x-lg"></i>
            </button>

            <div class="sa-actions-title">عملیات تصویر</div>

            <button type="button" class="sa-action" @onclick="() => RotateImage(90)">
                <span class="sa-action-icon"><i class="bi bi-arrow-clockwise"></i></span>
                <span>چرخش</span>
            </button>

            <div class="sa-group-field">
                <i class="bi bi-folder2-open"></i>
                <select class="form-select form-select-sm sa-group-select" @onchange="AssignModalToGroup" aria-label="انتخاب گروه">
                    <option value="">انتخاب گروه...</option>
                    @if (groups != null)
                    {
                        @foreach (DataRow g in groups.Rows)
                        {
                            <option value="@Str(g, "ImageGroupName")">@Str(g, "ImageGroupName")</option>
                        }
                    }
                </select>
            </div>

            @if (activeGroupId.HasValue)
            {
                <button type="button" class="sa-action warning" @onclick="RemoveFromCurrentGroup">
                    <span class="sa-action-icon"><i class="bi bi-folder-x"></i></span>
                    <span>حذف از گروه</span>
                </button>
            }

            <button type="button" class="sa-action" @onclick="DownloadCurrent">
                <span class="sa-action-icon"><i class="bi bi-download"></i></span>
                <span>دانلود</span>
            </button>

            <button type="button" class="sa-action danger" @onclick="DeleteCurrentImage">
                <span class="sa-action-icon"><i class="bi bi-trash"></i></span>
                <span>حذف</span>
            </button>
        </aside>

        @if (modalBusy)
        {
            <div class="text-white text-center">
                <div class="spinner-border"></div>
                <p class="mt-2 small">در حال پردازش...</p>
            </div>
        }
        @if (!string.IsNullOrEmpty(modalImageSrc))
        {
            <img class="sa-preview-image" src="@modalImageSrc" alt="پیش‌نمایش" style="@(modalBusy ? "opacity:0.3" : "")" />
        }
    </div>
}

@code {
    [Parameter] public HubConnection? Hub { get; set; }
    [Parameter] public string? SoftwareCode { get; set; }
    [Parameter] public string? PicType { get; set; }
    [Parameter] public string? RelationCode { get; set; }
    [Parameter] public string? UserCode { get; set; }
    [Parameter] public EventCallback<(string Text, string Type)> OnMessage { get; set; }

    // Gallery state
    private DataTable? gallery;
    private DataTable? groups;
    private int galleryTotal = 0;
    private int gallerySkip = 0;
    private const int GalleryPageSize = 20;
    private bool galleryLoading = false;
    private bool galleryReloadPending = false;
    private decimal? activeGroupId = null;
    private HashSet<decimal> selectedImages = new();
    private Dictionary<decimal, string> thumbnailCache = new();
    private string contextKey = string.Empty;

    // Modal state
    private decimal? modalImageId = null;
    private string modalImageSrc = "";
    private bool modalBusy = false;

    // Hub subscriptions
    private HubConnection? subscribedHub;
    private IDisposable? galleryChangedSub;
    private IDisposable? groupsChangedSub;

    private string CurrentContextKey => string.Join("|",
        SoftwareCode ?? string.Empty,
        PicType ?? string.Empty,
        RelationCode ?? string.Empty,
        UserCode ?? string.Empty);

    protected override async Task OnInitializedAsync()
    {
        contextKey = CurrentContextKey;
        await LoadGroups();
        await LoadGallery(reset: true);
    }

    protected override async Task OnParametersSetAsync()
    {
        // اشتراک رویدادهای هاب (یک‌بار برای هر اتصال)
        if (Hub is not null && !ReferenceEquals(Hub, subscribedHub))
        {
            UnsubscribeHub();
            subscribedHub = Hub;

            galleryChangedSub = Hub.On("GalleryChanged", async () => await InvokeAsync(async () =>
            {
                await LoadGallery(reset: true);
                StateHasChanged();
            }));

            groupsChangedSub = Hub.On("GroupsChanged", async () => await InvokeAsync(async () =>
            {
                await LoadGroups();
                StateHasChanged();
            }));
        }

        // با تغییر فیلترها (کدهای زمینه) گالری از نو بارگذاری می‌شود
        var nextKey = CurrentContextKey;
        if (!string.Equals(contextKey, nextKey, StringComparison.Ordinal))
        {
            contextKey = nextKey;
            await LoadGallery(reset: true);
        }
    }

    // ───────────────────────── Data Loading ─────────────────────────

    private async Task LoadGroups()
    {
        try
        {
            groups = await ScanService.GetGroupsDataTableAsync();
        }
        catch (Exception ex)
        {
            await Notify($"خطا در بارگذاری گروه‌ها: {ex.Message}", "danger");
            groups = new DataTable();
        }
    }

    private async Task LoadGallery(bool reset)
    {
        if (galleryLoading)
        {
            if (reset) galleryReloadPending = true;
            return;
        }

        var reloadAgain = false;
        galleryLoading = true;
        try
        {
            if (reset)
            {
                gallerySkip = 0;
                gallery = new DataTable();
                thumbnailCache.Clear();
            }

            var (dt, total) = await ScanService.GetGalleryPageAsync(
                gallerySkip,
                GalleryPageSize,
                activeGroupId,
                RelationCode,
                PicType,
                UserCode,
                SoftwareCode);

            if (gallery is null || gallery.Columns.Count == 0)
            {
                gallery = dt;
            }
            else
            {
                foreach (DataRow row in dt.Rows)
                    gallery.ImportRow(row);
            }

            galleryTotal = total;
            gallerySkip += dt.Rows.Count;

            if (reset) selectedImages.Clear();
        }
        catch (Exception ex)
        {
            await Notify($"خطا در بارگذاری گالری: {ex.Message}", "danger");
        }
        finally
        {
            galleryLoading = false;
            reloadAgain = galleryReloadPending;
            galleryReloadPending = false;
        }

        if (reloadAgain)
            await LoadGallery(reset: true);
    }

    private async Task LoadMoreGallery() => await LoadGallery(reset: false);

    // ───────────────────────── Gallery Interactions ─────────────────────────

    private void ToggleSelect(decimal id)
    {
        if (selectedImages.Contains(id)) selectedImages.Remove(id);
        else selectedImages.Add(id);
    }

    private async Task SelectGroup(decimal? id)
    {
        activeGroupId = id;
        await LoadGallery(reset: true);
    }

    private async Task CreateGroup()
    {
        var name = await JS.InvokeAsync<string?>("prompt", "نام گروه جدید:");
        if (string.IsNullOrWhiteSpace(name) || Hub == null) return;
        try
        {
            await Hub.InvokeAsync("CreateGroup", name.Trim(), SoftwareCode);
            await LoadGroups();
            await Notify($"گروه «{name.Trim()}» ساخته شد.", "success");
        }
        catch (Exception ex)
        {
            await Notify($"خطا در ساخت گروه: {ex.Message}", "danger");
        }
    }

    private async Task AssignSelectedToGroup(ChangeEventArgs e)
    {
        var groupName = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(groupName) || Hub == null || selectedImages.Count == 0) return;

        foreach (var id in selectedImages.ToList())
        {
            try { await Hub.InvokeAsync("AssignImageToGroup", id, groupName.Trim(), SoftwareCode); }
            catch { }
        }
        selectedImages.Clear();
        await LoadGallery(reset: true);
        await Notify($"تصاویر به گروه «{groupName.Trim()}» اضافه شد.", "success");
    }

    private async Task DeleteSelectedImages()
    {
        if (Hub == null || selectedImages.Count == 0) return;
        var ok = await JS.InvokeAsync<bool>("confirm", $"{selectedImages.Count} تصویر حذف شود؟");
        if (!ok) return;

        foreach (var id in selectedImages.ToList())
        {
            try { await Hub.InvokeAsync("DeleteImage", id); }
            catch { }
        }
        selectedImages.Clear();
        await LoadGallery(reset: true);
        await Notify("تصاویر حذف شد.", "warning");
    }

    // ───────────────────────── Modal ─────────────────────────

    private async Task OpenImage(decimal id)
    {
        modalImageId = id;
        modalBusy = true;
        modalImageSrc = "";
        try
        {
            var bytes = await ScanService.GetImageDataAsync(id);
            if (bytes != null)
                modalImageSrc = $"data:image/jpeg;base64,{Convert.ToBase64String(bytes)}";
        }
        catch (Exception ex)
        {
            await Notify($"خطا در بارگذاری تصویر: {ex.Message}", "danger");
        }
        finally
        {
            modalBusy = false;
        }
    }

    private void CloseModal() => modalImageId = null;

    private void HandleModalKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseModal();
    }

    private async Task RotateImage(int angle)
    {
        if (modalImageId == null || Hub == null) return;
        modalBusy = true;
        try
        {
            var ok = await Hub.InvokeAsync<bool>("RotateImage", modalImageId.Value, angle);
            if (ok)
            {
                await OpenImage(modalImageId.Value);
                await Notify("تصویر چرخید.", "success");
            }
            else
            {
                await Notify("خطا در چرخش تصویر.", "danger");
            }
        }
        catch (Exception ex)
        {
            await Notify($"خطا: {ex.Message}", "danger");
        }
        finally
        {
            modalBusy = false;
        }
    }

    private async Task AssignModalToGroup(ChangeEventArgs e)
    {
        var groupName = e.Value?.ToString();
        if (modalImageId == null || Hub == null || string.IsNullOrWhiteSpace(groupName)) return;

        try
        {
            await Hub.InvokeAsync("AssignImageToGroup", modalImageId.Value, groupName.Trim(), SoftwareCode);
            await LoadGallery(reset: true);
            await Notify($"تصویر به گروه «{groupName.Trim()}» اضافه شد.", "success");
        }
        catch (Exception ex)
        {
            await Notify($"خطا: {ex.Message}", "danger");
        }
    }

    private async Task RemoveFromCurrentGroup()
    {
        if (modalImageId == null || Hub == null || !activeGroupId.HasValue) return;

        try
        {
            await Hub.InvokeAsync("RemoveImageFromGroup", modalImageId.Value, activeGroupId.Value);
            await LoadGallery(reset: true);
            await Notify("تصویر از گروه حذف شد.", "warning");
        }
        catch (Exception ex)
        {
            await Notify($"خطا: {ex.Message}", "danger");
        }
    }

    private async Task DownloadCurrent()
    {
        if (modalImageId == null) return;
        var shortId = modalImageId.Value.ToString("0");
        if (shortId.Length > 8) shortId = shortId[..8];
        await JS.InvokeVoidAsync("eval",
            $"var a=document.createElement('a');a.href='{modalImageSrc}';a.download='scan_{shortId}.jpg';document.body.appendChild(a);a.click();a.remove();");
    }

    private async Task DeleteCurrentImage()
    {
        if (modalImageId == null || Hub == null) return;
        var ok = await JS.InvokeAsync<bool>("confirm", "این تصویر حذف شود؟");
        if (!ok) return;

        try
        {
            await Hub.InvokeAsync("DeleteImage", modalImageId.Value);
            modalImageId = null;
            await LoadGallery(reset: true);
            await Notify("تصویر حذف شد.", "warning");
        }
        catch (Exception ex)
        {
            await Notify($"خطا در حذف: {ex.Message}", "danger");
        }
    }

    // ───────────────────────── Helpers ─────────────────────────

    private string GetThumbnailSrc(decimal id)
    {
        if (thumbnailCache.TryGetValue(id, out var src)) return src;
        _ = LoadThumbnailAsync(id);
        return "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7";
    }

    private async Task LoadThumbnailAsync(decimal id)
    {
        try
        {
            var bytes = await ScanService.GetImageThumbnailAsync(id);
            if (bytes is null || bytes.Length == 0)
                bytes = await ScanService.GetImageDataAsync(id);
            if (bytes != null)
            {
                thumbnailCache[id] = $"data:image/jpeg;base64,{Convert.ToBase64String(bytes)}";
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { }
    }

    private async Task Notify(string text, string type)
    {
        if (OnMessage.HasDelegate)
            await OnMessage.InvokeAsync((text, type));
    }

    private void UnsubscribeHub()
    {
        galleryChangedSub?.Dispose();
        groupsChangedSub?.Dispose();
        galleryChangedSub = null;
        groupsChangedSub = null;
    }

    private static string Str(DataRow r, string col)
        => r.IsNull(col) ? string.Empty : r[col]?.ToString() ?? string.Empty;

    private static decimal DecVal(DataRow r, string col)
        => r.IsNull(col) ? 0 : Convert.ToDecimal(r[col]);

    public ValueTask DisposeAsync()
    {
        UnsubscribeHub();
        return ValueTask.CompletedTask;
    }
}

@using Microsoft.AspNetCore.Components

<div class="sa-loading-overlay">
    <div class="sa-loading-card">
        <div class="sa-spinner"></div>
        <h6 class="mt-3 mb-1">@Title</h6>
        <p class="text-muted small mb-0">@Subtitle</p>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "در حال بارگذاری...";
    [Parameter] public string Subtitle { get; set; } = "لطفاً منتظر بمانید";
}

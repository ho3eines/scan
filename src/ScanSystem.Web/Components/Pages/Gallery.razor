@page "/gallery"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.SignalR.Client
@using ScanSystem.Shared
@using ScanSystem.Shared.Entities
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IScanService ScanService
@inject HttpClient Http
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>گالری اسکن‌ها</PageTitle>

@if (isScanning)
{
    <div class="gallery-fullscreen" style="background:rgba(0,0,0,0.55)">
        <div class="text-center text-white">
            <div class="scan-spinner mx-auto"></div>
            <h5 class="mt-3">در حال اسکن... لطفاً منتظر بمانید</h5>
        </div>
    </div>
}

<div class="container-fluid mt-3" dir="rtl">
    @* هدر + وضعیت اتصال *@
    <div class="card shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="mb-0"><i class="bi bi-images text-primary"></i> گالری اسکن‌ها</h5>
                <div class="d-flex align-items-center gap-2">
                    <span class="agent-dot @(isConnected ? "online" : "offline")"></span>
                    <small class="text-muted">@(isConnected ? "سرور متصل" : "سرور قطع")</small>
                    <span class="badge bg-light text-dark ms-2">@gallery.Count / @total نمایش داده شد</span>
                </div>
            </div>
        </div>
    </div>

    @* نوار ابزار: اسکن + گروه‌ها + دانلود ZIP دسته‌ای *@
    <div class="card shadow-sm mb-3">
        <div class="card-body py-2 d-flex align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <label class="form-label mb-0 small text-muted">دستگاه:</label>
                <select class="form-select form-select-sm" style="width:auto" @bind="activeMachine">
                    <option value="">همه</option>
                    @if (agents != null)
                    {
                        @foreach (var a in agents.Machines)
                        {
                            <option value="@a">@a</option>
                        }
                    }
                </select>
            </div>

            <div class="form-check form-check-inline mb-0">
                <input class="form-check-input" type="checkbox" id="chkGalleryMultiPage" @bind="scanMultiPage" />
                <label class="form-check-label small" for="chkGalleryMultiPage">چندصفحه‌ای (ADF)</label>
            </div>

            <button class="btn btn-success btn-sm" disabled="@(!canScan || isScanning)" @onclick="StartScan">
                @if (isScanning) { <span class="spinner-border spinner-border-sm me-2"></span> }
                <i class="bi bi-camera me-1"></i> اسکن
            </button>

            <div class="d-flex align-items-center gap-1 flex-wrap ms-2">
                <span class="group-chip @(activeGroup == null ? "active" : "")"
                      @onclick="() => { activeGroup = null; ResetAndLoad(); }">
                    <i class="bi bi-grid"></i> همه
                </span>
                @if (groups != null)
                {
                    @foreach (var g in groups)
                    {
                        <span class="group-chip@(activeGroup?.Id == g.Id ? " active" : "")"
                              @ondragenter="@(e => dragOverGroup = g.Id)"
                              @ondragover:preventDefault
                              @ondragleave="@(() => dragOverGroup = null)"
                              @ondrop="@(async () => await DropOnGroup(g))"
                              @onclick="() => { activeGroup = g; ResetAndLoad(); }"
                              style="@(dragOverGroup == g.Id ? "background:#fff3cd;border-color:#ffc107;transform:scale(1.05)" : "")">
                            <i class="bi bi-folder2"></i> @g.Name
                            <i class="bi bi-x-circle text-danger ms-1" style="font-size:11px"
                               title="حذف گروه" @onclick:stopPropagation="true" @onclick="() => DeleteGroup(g)"></i>
                        </span>
                    }
                }
                <button class="btn btn-sm btn-outline-primary" @onclick="CreateGroup">
                    <i class="bi bi-plus-lg"></i> گروه جدید
                </button>
            </div>

            @if (selectedImages.Count > 0)
            {
                <button class="btn btn-primary btn-sm ms-auto" @onclick="DownloadZip">
                    <i class="bi bi-download"></i> دانلود ZIP (@selectedImages.Count)
                </button>
                <button class="btn btn-outline-danger btn-sm" @onclick="DeleteSelected">
                    <i class="bi bi-trash"></i> حذف (@selectedImages.Count)
                </button>
            }
        </div>
    </div>

    @* گرید گالری (Lazy Load) *@
    @if (gallery.Count == 0 && !loading)
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox display-1 text-muted"></i>
            <p class="mt-3 text-muted">هنوز اسکنی ثبت نشده است.</p>
            <p class="text-muted small">روی دکمه «اسکن» بزنید یا دستگاه مورد نظر را انتخاب کنید.</p>
        </div>
    }
    else
    {
        <div class="gallery-grid" id="@gridId">
            @foreach (var item in gallery)
            {
                var picked = selectedImages.Contains(item.Id);
                <div class="gallery-tile@(picked ? " selected" : "")"
                     draggable="true"
                     @ondragstart="@(() => DragImage = item.Id)"
                     @ondragend="@(() => DragImage = Guid.Empty)"
                     @onclick="() => OpenFullscreen(item.Id)"
                     style="@((dragOverGroup != null && DragImage == item.Id) ? "opacity:0.5" : "")">
                    <input type="checkbox" class="tile-check" checked="@picked"
                           @onclick="@(() => ToggleSelect(item.Id))"
                           @onclick:stopPropagation="true" />
                    <span class="tile-badge">@(string.IsNullOrEmpty(item.Groups) ? "—" : item.Groups)</span>
                    <img src="@($"/api/images/thumb/{item.Id}")" loading="lazy" alt="@item.FileName" />
                    <div class="tile-info">
                        @item.AgentMachineName • @item.CreatedAt.ToString("MM/dd HH:mm")
                    </div>
                </div>
            }
        </div>

        @* دکمه «بارگذاری بیشتر» برای Lazy Loading *@
        <div class="text-center mt-3 mb-4">
            @if (loading)
            {
                <div class="spinner-border text-primary"></div>
                <p class="mt-2 text-muted small">در حال بارگذاری...</p>
            }
            else if (gallery.Count < total)
            {
                <button class="btn btn-outline-primary" @onclick="LoadMore">
                    <i class="bi bi-arrow-down-circle me-1"></i> بارگذاری بیشتر
                    <span class="badge bg-secondary ms-1">@(total - gallery.Count) مورد باقی‌مانده</span>
                </button>
            }
            else if (total > 0)
            {
                <p class="text-muted small">
                    <i class="bi bi-check-circle text-success"></i> همه @total مورد بارگذاری شد.
                </p>
            }
        </div>
    }

    @* پیام *@
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-@messageType alert-dismissible fade show" role="alert">
            @message
            <button type="button" class="btn-close" @onclick="() => message = null"></button>
        </div>
    }
</div>

@* مودال فول‌اسکرین با نوارابزار ویرایش (چرخش / جایگزینی / گروه / حذف) *@
@if (fullscreenId != null)
{
    <div class="gallery-fullscreen" tabindex="0"
         @onkeydown="@(e => { if (e.Key == "Escape") CloseFullscreen(); })">
        <div class="fs-toolbar">
            <div class="btn-group" role="group">
                <button class="btn btn-light btn-sm" title="چرخش ۹۰ درجه" @onclick="() => RotateImage(90)">
                    <i class="bi bi-arrow-clockwise"></i> چرخش
                </button>
                <label class="btn btn-light btn-sm mb-0" title="جایگزینی با فایل جدید">
                    <i class="bi bi-upload"></i> جایگزینی
                    <InputFile OnChange="ReplaceImage" style="display:none" accept="image/*" />
                </label>
                <select class="form-select form-select-sm border-0" style="width:auto"
                        title="افزودن به گروه" @onchange="AssignFromModal">
                    <option value="">گروه...</option>
                    @if (groups != null)
                    {
                        @foreach (var g in groups)
                        {
                            <option value="@g.Name">@g.Name</option>
                        }
                    }
                </select>
                <button class="btn btn-outline-light btn-sm" title="دانلود تصویر" @onclick="DownloadCurrent">
                    <i class="bi bi-download"></i>
                </button>
                <button class="btn btn-danger btn-sm" title="حذف تصویر" @onclick="DeleteFromModal">
                    <i class="bi bi-trash"></i> حذف
                </button>
            </div>
            <button class="btn btn-light btn-sm fs-exit" @onclick="CloseFullscreen">
                <i class="bi bi-x-lg"></i> خروج
            </button>
        </div>

        @if (editorBusy)
        {
            <div class="text-white text-center">
                <div class="spinner-border"></div>
                <p class="mt-2 small">در حال پردازش...</p>
            </div>
        }
        <img src="@FullscreenUrl" alt="پیش‌نمایش" style="@(editorBusy ? "opacity:0.3" : "")" />
    </div>
}

@code {
    private HubConnection? hub;

    // داده‌های گالری (Lazy Loaded)
    private List<ImageGalleryItemDto> gallery = new();
    private int total = 0;
    private int skip = 0;
    private const int PageSize = 20;
    private bool loading = false;
    private const string gridId = "galleryGrid";

    // Agentها (ساختار مرکب برای انتخاب دستگاه)
    private AgentListDto agents = new();
    private string? activeMachine = null;
    private bool scanMultiPage = true;

    // گروه‌ها
    private List<ImageGroup>? groups;
    private ImageGroup? activeGroup = null;
    private Guid? dragOverGroup = null;
    private Guid DragImage = Guid.Empty;

    // انتخاب چندگانه
    private HashSet<Guid> selectedImages = new();

    // فول‌اسکرین / ویرایشگر
    private Guid? fullscreenId = null;
    private long imageVersion = 0; // cache-buster بعد از چرخش/جایگزینی
    private bool editorBusy = false;

    // وضعیت
    private bool isConnected = false;
    private bool isScanning = false;
    private string? message;
    private string messageType = "info";

    private bool canScan => isConnected && !string.IsNullOrEmpty(activeMachine);

    private string FullscreenUrl => fullscreenId.HasValue
        ? $"/api/images/{fullscreenId.Value}?v={imageVersion}"
        : "";

    protected override async Task OnInitializedAsync()
    {
        await LoadAgents();
        await ReloadGroups();
        await LoadGalleryPage(reset: true);
        await ConnectHub();
    }

    private async Task ConnectHub()
    {
        hub = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/scanhub"))
            .WithAutomaticReconnect()
            .Build();

        hub.On("RequestsChanged", async () => await InvokeAsync(async () =>
        {
            await LoadAgents();
            StateHasChanged();
        }));

        hub.On("GalleryChanged", async () => await InvokeAsync(async () =>
        {
            await ReloadGroups();
            await LoadGalleryPage(reset: true);
            StateHasChanged();
        }));

        hub.On<Guid, Guid, int>("PageUploaded", async (requestId, imageId, pageNumber) => await InvokeAsync(async () =>
        {
            await LoadGalleryPage(reset: true);
            StateHasChanged();
        }));

        hub.On<Guid>("ScanCompleted", async (id) => await InvokeAsync(() =>
        {
            isScanning = false;
            message = "اسکن کامل شد.";
            messageType = "success";
            StateHasChanged();
        }));

        hub.On<Guid, string>("StatusChanged", async (id, status) => await InvokeAsync(() =>
        {
            if (status == ScanStatus.Error)
            {
                isScanning = false;
                message = "اسکن با خطا مواجه شد. لاگ Agent را بررسی کنید.";
                messageType = "danger";
            }
            StateHasChanged();
        }));

        hub.On<List<AgentDto>>("AgentsList", async (list) => await InvokeAsync(() =>
        {
            agents.Update(list);
            StateHasChanged();
        }));

        hub.On("AgentsChanged", async () => await InvokeAsync(async () =>
        {
            await LoadAgents();
            StateHasChanged();
        }));

        hub.Closed += async _ => { isConnected = false; await InvokeAsync(StateHasChanged); };
        hub.Reconnected += _ => { isConnected = true; return Task.CompletedTask; };

        try
        {
            await hub.StartAsync();
            isConnected = true;
        }
        catch (Exception ex)
        {
            message = $"خطای اتصال به سرور: {ex.Message}";
            messageType = "danger";
        }
    }

    private async Task LoadAgents()
    {
        try
        {
            var list = await ScanService.GetAgentsAsync();
            agents.Update(list);
        }
        catch { }
    }

    private async Task ReloadGroups()
    {
        try { groups = await ScanService.GetGroupsAsync(); }
        catch { groups = new List<ImageGroup>(); }
    }

    private async Task LoadGalleryPage(bool reset)
    {
        if (loading) return;
        loading = true;
        try
        {
            if (reset)
            {
                skip = 0;
                gallery.Clear();
            }

            Guid? groupId = activeGroup?.Id;
            string? machine = string.IsNullOrEmpty(activeMachine) ? null : activeMachine;

            var (items, tot) = await ScanService.GetGalleryPageAsync(skip, PageSize, groupId, machine);
            gallery.AddRange(items);
            total = tot;
            skip += items.Count;

            // رفع موارد انتخاب‌شده‌ای که دیگر وجود ندارند
            if (reset) selectedImages.Clear();
        }
        catch (Exception ex)
        {
            message = $"خطا در بارگذاری گالری: {ex.Message}";
            messageType = "danger";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadMore() => await LoadGalleryPage(reset: false);

    private async Task ResetAndLoad() => await LoadGalleryPage(reset: true);

    private async Task StartScan()
    {
        if (!canScan || hub == null || string.IsNullOrEmpty(activeMachine)) return;
        isScanning = true;
        message = "درخواست اسکن ارسال شد...";
        messageType = "info";
        try
        {
            await hub.InvokeAsync("RequestScan", activeMachine, scanMultiPage);
        }
        catch (Exception ex)
        {
            isScanning = false;
            message = $"خطا: {ex.Message}";
            messageType = "danger";
        }
    }

    private void ToggleSelect(Guid id)
    {
        if (selectedImages.Contains(id)) selectedImages.Remove(id);
        else selectedImages.Add(id);
    }

    private void OpenFullscreen(Guid id)
    {
        fullscreenId = id;
        imageVersion = DateTime.Now.Ticks;
    }

    private void CloseFullscreen() => fullscreenId = null;

    // ─────────── ویرایش تصویر در مودال ───────────

    private async Task RotateImage(int angle)
    {
        if (fullscreenId == null) return;
        editorBusy = true;
        StateHasChanged();
        try
        {
            var url = Navigation.ToAbsoluteUri($"/api/images/{fullscreenId}/rotate");
            var body = System.Text.Json.JsonSerializer.Serialize(new { angle });
            var resp = await Http.PostAsync(url, new StringContent(body, System.Text.Encoding.UTF8, "application/json"));
            if (resp.IsSuccessStatusCode)
            {
                imageVersion = DateTime.Now.Ticks; // کش‌شکن → تصویر دوباره بارگذاری می‌شود
                message = $"تصویر {angle} درجه چرخید.";
                messageType = "success";
            }
            else
            {
                message = "خطا در چرخش تصویر.";
                messageType = "danger";
            }
        }
        catch (Exception ex)
        {
            message = $"خطا: {ex.Message}";
            messageType = "danger";
        }
        finally
        {
            editorBusy = false;
            StateHasChanged();
        }
    }

    private async Task ReplaceImage(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        if (fullscreenId == null) return;
        var file = e.File;
        if (file == null) return;
        editorBusy = true;
        StateHasChanged();
        try
        {
            const long maxBytes = 40L * 1024 * 1024;
            using var stream = file.OpenReadStream(maxBytes);
            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(fileContent, "file", file.Name);

            var url = Navigation.ToAbsoluteUri($"/api/images/{fullscreenId}/replace");
            var resp = await Http.PostAsync(url, content);
            if (resp.IsSuccessStatusCode)
            {
                imageVersion = DateTime.Now.Ticks;
                message = "تصویر جایگزین شد.";
                messageType = "success";
                await LoadGalleryPage(reset: true); // thumbnail هم تازه شود
            }
            else
            {
                message = $"خطا در جایگزینی تصویر ({(int)resp.StatusCode}).";
                messageType = "danger";
            }
        }
        catch (Exception ex)
        {
            message = $"خطا: {ex.Message}";
            messageType = "danger";
        }
        finally
        {
            editorBusy = false;
            StateHasChanged();
        }
    }

    private async Task DeleteFromModal()
    {
        if (fullscreenId == null) return;
        var id = fullscreenId.Value;
        try
        {
            await ScanService.DeleteImageAsync(id);
            selectedImages.Remove(id);
            fullscreenId = null;
            message = "تصویر حذف شد.";
            messageType = "warning";
            await LoadGalleryPage(reset: true);
        }
        catch (Exception ex)
        {
            message = $"خطا در حذف: {ex.Message}";
            messageType = "danger";
        }
    }

    private async Task DownloadCurrent()
    {
        if (fullscreenId == null) return;
        // دانلود مستقیم با GET: ساخت لنگر موقت و کلیک روی آن.
        var shortId = fullscreenId.Value.ToString()[..8];
        await JS.InvokeVoidAsync("eval",
            $"var a=document.createElement('a');a.href='/api/images/{fullscreenId}';a.download='scan_{shortId}.jpg';document.body.appendChild(a);a.click();a.remove();");
    }

    private async Task AssignFromModal(ChangeEventArgs e)
    {
        var groupName = e.Value?.ToString();
        if (fullscreenId == null || string.IsNullOrWhiteSpace(groupName)) return;
        await AssignGroup(fullscreenId.Value, groupName);
    }

    // ─────────── Drag & Drop گروه‌بندی ───────────

    private async Task DropOnGroup(ImageGroup g)
    {
        dragOverGroup = null;
        if (DragImage == Guid.Empty) return;
        var imageId = DragImage;
        DragImage = Guid.Empty;
        await AssignGroup(imageId, g.Name);
    }

    private async Task AssignGroup(Guid imageId, string? groupName)
    {
        try
        {
            var url = Navigation.ToAbsoluteUri("/api/images/assignGroup");
            var body = System.Text.Json.JsonSerializer.Serialize(new { imageId, groupName });
            var resp = await Http.PostAsync(url, new StringContent(body, System.Text.Encoding.UTF8, "application/json"));
            if (resp.IsSuccessStatusCode)
            {
                var item = gallery.FirstOrDefault(x => x.Id == imageId);
                if (item != null && !string.IsNullOrWhiteSpace(groupName))
                {
                    // نام گروه به فهرست گروه‌های تصویر اضافه می‌شود (بدون تکرار).
                    var existing = (item.Groups ?? "")
                        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                        .ToHashSet();
                    existing.Add(groupName.Trim());
                    item.Groups = string.Join("، ", existing.OrderBy(x => x));
                }
                await ReloadGroups();
                message = $"تصویر به گروه «{groupName}» اضافه شد.";
                messageType = "success";
            }
        }
        catch (Exception ex)
        {
            message = $"خطا: {ex.Message}";
            messageType = "danger";
        }
    }

    private async Task CreateGroup()
    {
        var name = await JS.InvokeAsync<string>("prompt", "نام گروه جدید را وارد کنید:", "گروه ۱");
        if (string.IsNullOrWhiteSpace(name)) return;
        try
        {
            var created = await ScanService.CreateGroupAsync(name.Trim());
            await ReloadGroups();
            activeGroup = created;
            await ResetAndLoad();
        }
        catch (Exception ex)
        {
            message = $"خطا در ساخت گروه: {ex.Message}";
            messageType = "danger";
        }
    }

    private async Task DeleteGroup(ImageGroup g)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"گروه «{g.Name}» حذف شود؟ (تصاویر حذف نمی‌شوند)");
        if (!ok) return;
        try
        {
            await ScanService.DeleteGroupAsync(g.Id);
            if (activeGroup?.Id == g.Id) activeGroup = null;
            await ReloadGroups();
            await ResetAndLoad();
            message = $"گروه «{g.Name}» حذف شد.";
            messageType = "warning";
        }
        catch (Exception ex)
        {
            message = $"خطا در حذف گروه: {ex.Message}";
            messageType = "danger";
        }
    }

    // ─────────── انتخاب دسته‌ای ───────────

    private async Task DownloadZip()
    {
        if (selectedImages.Count == 0) return;
        try
        {
            var url = Navigation.ToAbsoluteUri("/api/zip").ToString();
            var body = System.Text.Json.JsonSerializer.Serialize(new { ids = selectedImages.ToArray() });
            var ok = await JS.InvokeAsync<bool>("scanSystem.postDownload", url, body,
                $"scans_{DateTime.Now:yyyyMMdd_HHmmss}.zip");
            if (ok)
            {
                selectedImages.Clear();
                message = "فایل ZIP آماده و دانلود شد.";
                messageType = "success";
            }
            else
            {
                message = "خطا در ساخت ZIP.";
                messageType = "danger";
            }
        }
        catch (Exception ex)
        {
            message = $"خطا: {ex.Message}";
            messageType = "danger";
        }
    }

    private async Task DeleteSelected()
    {
        var ids = selectedImages.ToArray();
        selectedImages.Clear();
        foreach (var id in ids)
        {
            try { await ScanService.DeleteImageAsync(id); } catch { }
        }
        message = $"{ids.Length} تصویر حذف شد.";
        messageType = "warning";
        await LoadGalleryPage(reset: true);
    }

    public async ValueTask DisposeAsync()
    {
        if (hub is not null) await hub.DisposeAsync();
    }
}

@page "/"
@page "/scan"
@rendermode InteractiveServer
@using System.Data
@using Microsoft.AspNetCore.SignalR.Client
@using ScanSystem.Shared
@using ScanSystem.Shared.Entities
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IScanService ScanService
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>اسکن مدارک</PageTitle>

@if (isScanning)
{
    <LoadingOverlay Title="در حال اسکن..." Subtitle="لطفاً سند را در اسکنر قرار دهید" />
}

<div class="container-fluid mt-3" dir="rtl">
    <!-- هدر + تنظیمات -->
    <div class="card shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="mb-0"><i class="bi bi-camera-fill text-primary"></i> اسکن مدارک</h5>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="agent-dot @(isConnected ? "online" : "offline")"></span>
                    <small class="text-muted">@(isConnected ? "سرور متصل" : "سرور قطع")</small>
                </div>
            </div>

            <hr class="my-2" />

            <div class="d-flex align-items-center flex-wrap gap-3">
                <div class="d-flex align-items-center gap-2">
                    <label class="form-label mb-0 small text-muted">دستگاه:</label>
                    @if (agents == null)
                    {
                        <select class="form-select form-select-sm" disabled style="min-width:160px">
                            <option>در حال بارگذاری...</option>
                        </select>
                    }
                    else if (agents.Rows.Count == 0)
                    {
                        <select class="form-select form-select-sm" disabled style="min-width:160px">
                            <option>بدون Agent</option>
                        </select>
                        <small class="text-danger">ابتدا Agent را اجرا و متصل کنید.</small>
                    }
                    else
                    {
                        <select class="form-select form-select-sm" style="min-width:160px" @bind="selectedMachine" @bind:after="OnMachineChanged">
                            <option value="">— انتخاب کنید —</option>
                            @foreach (DataRow row in agents.Rows)
                            {
                                var name = Str(row, "MachineName");
                                var online = Bool(row, "IsOnline");
                                <option value="@name">
                                    @name @(online ? "✓" : "✗")
                                </option>
                            }
                        </select>
                        <span class="badge @(selectedOnline ? "bg-success" : "bg-secondary")">
                            @(selectedOnline ? "آنلاین" : "آفلاین")
                        </span>
                    }
                </div>

                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="chkMultiPage" @bind="multiPage" @bind:after="OnMultiPageChanged" />
                    <label class="form-check-label small" for="chkMultiPage">چندصفحه‌ای (ADF)</label>
                </div>

                <button class="btn btn-success btn-sm" @onclick="StartScan" disabled="@(!CanScan)">
                    @if (isScanning)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    else
                    {
                        <i class="bi bi-camera me-1"></i>
                    }
                    شروع اسکن
                </button>

                <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshAll">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>

            @if (HasScanContext)
            {
                <div class="scan-context-strip mt-2">
                    <span class="scan-context-title"><i class="bi bi-link-45deg"></i> زمینه اسکن</span>
                    @if (!string.IsNullOrEmpty(CurrentRelationCode))
                    {
                        <span class="scan-context-chip">ریلیشن: <b>@CurrentRelationCode</b></span>
                    }
                    @if (!string.IsNullOrEmpty(CurrentInquiryCode))
                    {
                        <span class="scan-context-chip">اینکویری: <b>@CurrentInquiryCode</b></span>
                    }
                    @if (!string.IsNullOrEmpty(CurrentSoftwareCode))
                    {
                        <span class="scan-context-chip">سافتور: <b>@CurrentSoftwareCode</b></span>
                    }
                </div>
            }
        </div>
    </div>

    <!-- پیام‌ها -->
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-@messageType alert-dismissible fade show" role="alert">
            <i class="bi bi-@(AlertIcon)"></i> @message
            <button type="button" class="btn-close" @onclick="() => message = null"></button>
        </div>
    }

    <!-- گالری + گروه‌ها -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span><i class="bi bi-images"></i> گالری اسکن‌ها</span>
            <span class="badge bg-light text-dark">@galleryTotal تصویر</span>
        </div>
        <div class="card-body">
            <!-- نوار گروه‌ها -->
            <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
                <span class="group-chip @(activeGroupId == null ? "active" : "")" @onclick="() => SelectGroup(null)">
                    <i class="bi bi-grid"></i> همه
                </span>
                @if (groups != null)
                {
                    @foreach (DataRow g in groups.Rows)
                    {
                        var gid = GuidVal(g, "Id");
                        <span class="group-chip @(activeGroupId == gid ? "active" : "")" @onclick="() => SelectGroup(gid)">
                            <i class="bi bi-folder2"></i> @Str(g, "Name")
                        </span>
                    }
                }
                <button class="btn btn-sm btn-outline-primary" @onclick="CreateGroup">
                    <i class="bi bi-plus-lg"></i> گروه
                </button>
            </div>

            @if (galleryLoading && (gallery == null || gallery.Rows.Count == 0))
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2 text-muted small">در حال بارگذاری...</p>
                </div>
            }
            else if (gallery == null || gallery.Rows.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <p class="mt-3 text-muted">هنوز تصویری ثبت نشده است.</p>
                </div>
            }
            else
            {
                <div class="gallery-grid">
                    @foreach (DataRow row in gallery.Rows)
                    {
                        var imgId = GuidVal(row, "Id");
                        var selected = selectedImages.Contains(imgId);
                        <div class="gallery-tile@(selected ? " selected" : "")" @onclick="() => OpenImage(imgId)">
                            <input type="checkbox" class="tile-check" checked="@selected"
                                   @onclick:stopPropagation="true" @onclick="() => ToggleSelect(imgId)" />
                            <span class="tile-badge">@(string.IsNullOrEmpty(Str(row, "Groups")) ? "—" : Str(row, "Groups"))</span>
                            <img src="@GetThumbnailSrc(imgId)" loading="lazy" alt="@Str(row, "FileName")"
                                 onerror="this.src='data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxMDAiIGhlaWdodD0iMTAwIj48cmVjdCB3aWR0aD0iMTAwJSIgaGVpZ2h0PSIxMDAlIiBmaWxsPSIjZjFmM2Y1Ii8+PHRleHQgeD0iNTAlIiB5PSI1MCUiIGZvbnQtc2l6ZT0iMTIiIHRleHQtYW5jaG9yPSJtaWRkbGUiIGZpbGw9IiM2Yjc1N2QiPuaYpeeahOGJtOacjeWLmzwvdGV4dD48L3N2Zz4='" />
                            <div class="tile-info">
                                @Str(row, "AgentMachineName") • @FormatDate(row, "CreatedAt")
                            </div>
                        </div>
                    }
                </div>

                <div class="text-center mt-3">
                    @if (galleryLoading)
                    {
                        <div class="spinner-border text-primary"></div>
                    }
                    else if (gallery.Rows.Count < galleryTotal)
                    {
                        <button class="btn btn-outline-primary btn-sm" @onclick="LoadMoreGallery">
                            <i class="bi bi-arrow-down-circle"></i> بارگذاری بیشتر (@(galleryTotal - gallery.Rows.Count))
                        </button>
                    }
                </div>
            }

            @if (selectedImages.Count > 0)
            {
                <div class="d-flex align-items-center gap-2 mt-3 p-2 bg-light rounded">
                    <span class="small text-muted">@selectedImages.Count انتخاب شده:</span>
                    <select class="form-select form-select-sm" style="width:auto" @onchange="AssignSelectedToGroup">
                        <option value="">افزودن به گروه...</option>
                        @if (groups != null)
                        {
                            @foreach (DataRow g in groups.Rows)
                            {
                                <option value="@Str(g, "Name")">@Str(g, "Name")</option>
                            }
                        }
                    </select>
                    <button class="btn btn-outline-danger btn-sm" @onclick="DeleteSelectedImages">
                        <i class="bi bi-trash"></i> حذف
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => selectedImages.Clear()">
                        لغو
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- لیست درخواست‌ها برای کاربر نمایش داده نمی‌شود. -->

</div>

<!-- مودال پیش‌نمایش / ویرایش تصویر -->
@if (modalImageId.HasValue)
{
    <div class="gallery-fullscreen" tabindex="0" @onkeydown="HandleModalKey">
        <aside class="fs-action-panel" dir="rtl" aria-label="عملیات تصویر">
            <button type="button" class="fs-close-button" title="بستن" @onclick="CloseModal">
                <i class="bi bi-x-lg"></i>
            </button>

            <div class="fs-actions-title">عملیات تصویر</div>

            <button type="button" class="fs-action" @onclick="() => RotateImage(90)">
                <span class="fs-action-icon"><i class="bi bi-arrow-clockwise"></i></span>
                <span>چرخش</span>
            </button>

            <label class="fs-action fs-upload mb-0">
                <span class="fs-action-icon"><i class="bi bi-upload"></i></span>
                <span>جایگزینی</span>
                <InputFile OnChange="ReplaceImage" style="display:none" accept="image/*" />
            </label>

            <div class="fs-group-field">
                <i class="bi bi-folder2-open"></i>
                <select class="form-select form-select-sm fs-group-select" @onchange="AssignModalToGroup" aria-label="انتخاب گروه">
                    <option value="">انتخاب گروه...</option>
                    @if (groups != null)
                    {
                        @foreach (DataRow g in groups.Rows)
                        {
                            <option value="@Str(g, "Name")">@Str(g, "Name")</option>
                        }
                    }
                </select>
            </div>

            @if (activeGroupId.HasValue)
            {
                <button type="button" class="fs-action warning" @onclick="RemoveFromCurrentGroup">
                    <span class="fs-action-icon"><i class="bi bi-folder-x"></i></span>
                    <span>حذف از گروه</span>
                </button>
            }

            <button type="button" class="fs-action" @onclick="DownloadCurrent">
                <span class="fs-action-icon"><i class="bi bi-download"></i></span>
                <span>دانلود</span>
            </button>

            <button type="button" class="fs-action danger" @onclick="DeleteCurrentImage">
                <span class="fs-action-icon"><i class="bi bi-trash"></i></span>
                <span>حذف</span>
            </button>
        </aside>

        @if (modalBusy)
        {
            <div class="text-white text-center">
                <div class="spinner-border"></div>
                <p class="mt-2 small">در حال پردازش...</p>
            </div>
        }
        @if (!string.IsNullOrEmpty(modalImageSrc))
        {
            <img class="fs-preview-image" src="@modalImageSrc" alt="پیش‌نمایش" style="@(modalBusy ? "opacity:0.3" : "")" />
        }
    </div>
}

@code {
    private HubConnection? hub;

    [SupplyParameterFromQuery(Name = "relationCode")]
    public string? RelationCode { get; set; }

    [SupplyParameterFromQuery(Name = "inquiryCode")]
    public string? InquiryCode { get; set; }

    [SupplyParameterFromQuery(Name = "softwareCode")]
    public string? SoftwareCode { get; set; }

    // Settings
    private DataTable? agents;
    private string selectedMachine = "";
    private bool multiPage = true;
    private bool isConnected = false;
    private bool isScanning = false;
    private bool initialized = false;
    private string scanContextKey = string.Empty;

    // Gallery
    private DataTable? gallery;
    private DataTable? groups;
    private int galleryTotal = 0;
    private int gallerySkip = 0;
    private const int GalleryPageSize = 20;
    private bool galleryLoading = false;
    private bool galleryReloadPending = false;
    private Guid? activeGroupId = null;
    private HashSet<Guid> selectedImages = new();
    private Dictionary<Guid, string> thumbnailCache = new();

    // Modal
    private Guid? modalImageId = null;
    private string modalImageSrc = "";
    private bool modalBusy = false;

    // Requests
    private DataTable? requests;

    // Messages
    private string? message;
    private string messageType = "info";

    private bool selectedOnline => !string.IsNullOrEmpty(selectedMachine) &&
        agents?.Rows.Cast<DataRow>().Any(r => Str(r, "MachineName") == selectedMachine && Bool(r, "IsOnline")) == true;

    private bool CanScan => isConnected && !isScanning && !string.IsNullOrEmpty(selectedMachine) && selectedOnline;

    private string? CurrentRelationCode => NormalizeCode(RelationCode);
    private string? CurrentInquiryCode => NormalizeCode(InquiryCode);
    private string? CurrentSoftwareCode => NormalizeCode(SoftwareCode);
    private bool HasScanContext => CurrentRelationCode is not null || CurrentInquiryCode is not null || CurrentSoftwareCode is not null;
    private string CurrentScanContextKey => string.Join("|", CurrentRelationCode ?? string.Empty, CurrentInquiryCode ?? string.Empty, CurrentSoftwareCode ?? string.Empty);

    private string AlertIcon => messageType switch
    {
        "success" => "check-circle",
        "danger" => "exclamation-triangle",
        _ => "info-circle"
    };

    protected override async Task OnInitializedAsync()
    {
        scanContextKey = CurrentScanContextKey;
        await LoadSettings();
        await ConnectHub();
        await RefreshAll();
        initialized = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!initialized) return;

        var nextKey = CurrentScanContextKey;
        if (string.Equals(scanContextKey, nextKey, StringComparison.Ordinal)) return;

        scanContextKey = nextKey;
        await LoadGallery(reset: true);
    }

    // ───────────────────────── SignalR ─────────────────────────

    private async Task ConnectHub()
    {
        hub = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/scanhub"))
            .WithAutomaticReconnect()
            .Build();

        hub.On("RequestsChanged", async () => await InvokeAsync(StateHasChanged));

        hub.On("GalleryChanged", async () => await InvokeAsync(async () =>
        {
            await LoadGallery(reset: true);
            StateHasChanged();
        }));

        hub.On("GroupsChanged", async () => await InvokeAsync(async () =>
        {
            await LoadGroups();
            StateHasChanged();
        }));

        hub.On("AgentsChanged", async () => await InvokeAsync(async () =>
        {
            await LoadAgents();
            StateHasChanged();
        }));

        hub.On<string, bool>("AgentStatusChanged", async (_, _) => await InvokeAsync(async () =>
        {
            await LoadAgents();
            StateHasChanged();
        }));

        hub.On<List<AgentDto>>("AgentsList", async (list) => await InvokeAsync(async () =>
        {
            await LoadAgents();
            StateHasChanged();
        }));

        hub.On<Guid>("ScanCompleted", async (id) => await InvokeAsync(() =>
        {
            isScanning = false;
            ShowMessage("اسکن با موفقیت انجام شد.", "success");
            StateHasChanged();
        }));

        hub.On<Guid, string>("StatusChanged", async (id, status) => await InvokeAsync(() =>
        {
            if (status == ScanStatus.Error)
            {
                isScanning = false;
                ShowMessage("اسکن با خطا مواجه شد.", "danger");
            }
            StateHasChanged();
        }));

        hub.Closed += async _ => { isConnected = false; await InvokeAsync(StateHasChanged); };
        hub.Reconnected += _ => { isConnected = true; return Task.CompletedTask; };

        try
        {
            await hub.StartAsync();
            isConnected = true;
        }
        catch (Exception ex)
        {
            ShowMessage($"خطا در اتصال به سرور: {ex.Message}", "danger");
        }
    }

    // ───────────────────────── Settings / LocalStorage ─────────────────────────

    private async Task LoadSettings()
    {
        try
        {
            var machine = await JS.InvokeAsync<string?>("localStorage.getItem", "scan.selectedMachine");
            var mp = await JS.InvokeAsync<string?>("localStorage.getItem", "scan.multiPage");
            if (!string.IsNullOrEmpty(machine)) selectedMachine = machine;
            if (bool.TryParse(mp, out var parsed)) multiPage = parsed;
        }
        catch { }
    }

    private async Task SaveMachineSetting()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "scan.selectedMachine", selectedMachine);
        }
        catch { }
    }

    private async Task SaveMultiPageSetting()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "scan.multiPage", multiPage.ToString());
        }
        catch { }
    }

    private async Task OnMachineChanged()
    {
        await SaveMachineSetting();
    }

    private async Task OnMultiPageChanged()
    {
        await SaveMultiPageSetting();
    }

    // ───────────────────────── Data Loading ─────────────────────────

    private async Task RefreshAll()
    {
        await LoadAgents();
        await LoadGroups();
        await LoadGallery(reset: true);
    }

    private async Task LoadAgents()
    {
        try
        {
            agents = await ScanService.GetAgentsDataTableAsync();

            // اگر دستگاه انتخاب‌شده حذف یا آفلاین شده، اولین آنلاین را پیشنهاد بده.
            if (string.IsNullOrEmpty(selectedMachine) ||
                !agents.Rows.Cast<DataRow>().Any(r => Str(r, "MachineName") == selectedMachine))
            {
                var firstOnline = agents.Rows.Cast<DataRow>().FirstOrDefault(r => Bool(r, "IsOnline"));
                if (firstOnline != null)
                {
                    selectedMachine = Str(firstOnline, "MachineName");
                    await SaveMachineSetting();
                }
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"خطا در بارگذاری Agentها: {ex.Message}", "danger");
            agents = new DataTable();
        }
    }

    private async Task LoadGroups()
    {
        try
        {
            groups = await ScanService.GetGroupsDataTableAsync();
        }
        catch (Exception ex)
        {
            ShowMessage($"خطا در بارگذاری گروه‌ها: {ex.Message}", "danger");
            groups = new DataTable();
        }
    }

    private async Task LoadGallery(bool reset)
    {
        if (galleryLoading)
        {
            if (reset) galleryReloadPending = true;
            return;
        }

        var reloadAgain = false;
        galleryLoading = true;
        try
        {
            if (reset)
            {
                gallerySkip = 0;
                gallery = new DataTable();
                thumbnailCache.Clear();
            }

            var (dt, total) = await ScanService.GetGalleryPageAsync(
                gallerySkip,
                GalleryPageSize,
                activeGroupId,
                string.IsNullOrEmpty(selectedMachine) ? null : selectedMachine,
                CurrentRelationCode,
                CurrentInquiryCode,
                CurrentSoftwareCode);

            if (gallery is null || gallery.Columns.Count == 0)
            {
                gallery = dt;
            }
            else
            {
                foreach (DataRow row in dt.Rows)
                    gallery.ImportRow(row);
            }

            galleryTotal = total;
            gallerySkip += dt.Rows.Count;

            if (reset) selectedImages.Clear();
        }
        catch (Exception ex)
        {
            ShowMessage($"خطا در بارگذاری گالری: {ex.Message}", "danger");
        }
        finally
        {
            galleryLoading = false;
            reloadAgain = galleryReloadPending;
            galleryReloadPending = false;
        }

        if (reloadAgain)
            await LoadGallery(reset: true);
    }

    private async Task LoadMoreGallery() => await LoadGallery(reset: false);

    private async Task LoadRequests()
    {
        try
        {
            requests = await ScanService.GetRecentRequestsDataTableAsync(20);
        }
        catch (Exception ex)
        {
            ShowMessage($"خطا در بارگذاری درخواست‌ها: {ex.Message}", "danger");
            requests = new DataTable();
        }
    }

    // ───────────────────────── Scan ─────────────────────────

    private async Task StartScan()
    {
        if (hub == null || !CanScan) return;

        isScanning = true;
        ShowMessage("درخواست اسکن ارسال شد...", "info");
        try
        {
            await hub.InvokeAsync("RequestScanWithContext", selectedMachine, multiPage, CurrentRelationCode, CurrentInquiryCode, CurrentSoftwareCode);
        }
        catch (Exception ex)
        {
            isScanning = false;
            ShowMessage($"خطا در ارسال درخواست: {ex.Message}", "danger");
        }
    }

    // ───────────────────────── Gallery Interactions ─────────────────────────

    private void ToggleSelect(Guid id)
    {
        if (selectedImages.Contains(id)) selectedImages.Remove(id);
        else selectedImages.Add(id);
    }

    private async Task SelectGroup(Guid? id)
    {
        activeGroupId = id;
        await LoadGallery(reset: true);
    }

    private async Task CreateGroup()
    {
        var name = await JS.InvokeAsync<string?>("prompt", "نام گروه جدید:");
        if (string.IsNullOrWhiteSpace(name) || hub == null) return;
        try
        {
            await hub.InvokeAsync("CreateGroup", name.Trim());
            await LoadGroups();
            ShowMessage($"گروه «{name.Trim()}» ساخته شد.", "success");
        }
        catch (Exception ex)
        {
            ShowMessage($"خطا در ساخت گروه: {ex.Message}", "danger");
        }
    }

    private async Task AssignSelectedToGroup(ChangeEventArgs e)
    {
        var groupName = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(groupName) || hub == null || selectedImages.Count == 0) return;

        foreach (var id in selectedImages.ToList())
        {
            try { await hub.InvokeAsync("AssignImageToGroup", id, groupName.Trim()); }
            catch { }
        }
        selectedImages.Clear();
        await LoadGallery(reset: true);
        ShowMessage($"تصاویر به گروه «{groupName.Trim()}» اضافه شد.", "success");
    }

    private async Task DeleteSelectedImages()
    {
        if (hub == null || selectedImages.Count == 0) return;
        var ok = await JS.InvokeAsync<bool>("confirm", $"{selectedImages.Count} تصویر حذف شود؟");
        if (!ok) return;

        foreach (var id in selectedImages.ToList())
        {
            try { await hub.InvokeAsync("DeleteImage", id); }
            catch { }
        }
        selectedImages.Clear();
        await LoadGallery(reset: true);
        ShowMessage("تصاویر حذف شد.", "warning");
    }

    // ───────────────────────── Modal ─────────────────────────

    private async Task OpenImage(Guid id)
    {
        modalImageId = id;
        modalBusy = true;
        modalImageSrc = "";
        try
        {
            var bytes = await ScanService.GetImageDataAsync(id);
            if (bytes != null)
                modalImageSrc = $"data:image/jpeg;base64,{Convert.ToBase64String(bytes)}";
        }
        catch (Exception ex)
        {
            ShowMessage($"خطا در بارگذاری تصویر: {ex.Message}", "danger");
        }
        finally
        {
            modalBusy = false;
        }
    }

    private void CloseModal() => modalImageId = null;

    private void HandleModalKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseModal();
    }

    private async Task RotateImage(int angle)
    {
        if (modalImageId == null || hub == null) return;
        modalBusy = true;
        try
        {
            var ok = await hub.InvokeAsync<bool>("RotateImage", modalImageId.Value, angle);
            if (ok)
            {
                await OpenImage(modalImageId.Value);
                ShowMessage("تصویر چرخید.", "success");
            }
            else
            {
                ShowMessage("خطا در چرخش تصویر.", "danger");
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"خطا: {ex.Message}", "danger");
        }
        finally
        {
            modalBusy = false;
        }
    }

    private async Task ReplaceImage(InputFileChangeEventArgs e)
    {
        if (modalImageId == null || hub == null) return;
        var file = e.File;
        if (file == null) return;

        modalBusy = true;
        try
        {
            const long maxBytes = 40L * 1024 * 1024;
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxBytes).CopyToAsync(ms);
            var data = ms.ToArray();

            var ok = await hub.InvokeAsync<bool>("ReplaceImage", modalImageId.Value, data);
            if (ok)
            {
                await OpenImage(modalImageId.Value);
                ShowMessage("تصویر جایگزین شد.", "success");
            }
            else
            {
                ShowMessage("خطا در جایگزینی تصویر.", "danger");
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"خطا: {ex.Message}", "danger");
        }
        finally
        {
            modalBusy = false;
        }
    }

    private async Task AssignModalToGroup(ChangeEventArgs e)
    {
        var groupName = e.Value?.ToString();
        if (modalImageId == null || hub == null || string.IsNullOrWhiteSpace(groupName)) return;

        try
        {
            await hub.InvokeAsync("AssignImageToGroup", modalImageId.Value, groupName.Trim());
            await LoadGallery(reset: true);
            ShowMessage($"تصویر به گروه «{groupName.Trim()}» اضافه شد.", "success");
        }
        catch (Exception ex)
        {
            ShowMessage($"خطا: {ex.Message}", "danger");
        }
    }

    private async Task RemoveFromCurrentGroup()
    {
        if (modalImageId == null || hub == null || !activeGroupId.HasValue) return;

        try
        {
            await hub.InvokeAsync("RemoveImageFromGroup", modalImageId.Value, activeGroupId.Value);
            await LoadGallery(reset: true);
            ShowMessage("تصویر از گروه حذف شد.", "warning");
        }
        catch (Exception ex)
        {
            ShowMessage($"خطا: {ex.Message}", "danger");
        }
    }

    private async Task DownloadCurrent()
    {
        if (modalImageId == null) return;
        var shortId = modalImageId.Value.ToString()[..8];
        await JS.InvokeVoidAsync("eval",
            $"var a=document.createElement('a');a.href='{modalImageSrc}';a.download='scan_{shortId}.jpg';document.body.appendChild(a);a.click();a.remove();");
    }

    private async Task DeleteCurrentImage()
    {
        if (modalImageId == null || hub == null) return;
        var ok = await JS.InvokeAsync<bool>("confirm", "این تصویر حذف شود؟");
        if (!ok) return;

        try
        {
            await hub.InvokeAsync("DeleteImage", modalImageId.Value);
            modalImageId = null;
            await LoadGallery(reset: true);
            ShowMessage("تصویر حذف شد.", "warning");
        }
        catch (Exception ex)
        {
            ShowMessage($"خطا در حذف: {ex.Message}", "danger");
        }
    }

    // ───────────────────────── Helpers ─────────────────────────

    private string GetThumbnailSrc(Guid id)
    {
        if (thumbnailCache.TryGetValue(id, out var src)) return src;
        _ = LoadThumbnailAsync(id);
        return "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7";
    }

    private async Task LoadThumbnailAsync(Guid id)
    {
        try
        {
            var bytes = await ScanService.GetImageThumbnailAsync(id);
            if (bytes is null || bytes.Length == 0)
                bytes = await ScanService.GetImageDataAsync(id);
            if (bytes != null)
            {
                thumbnailCache[id] = $"data:image/jpeg;base64,{Convert.ToBase64String(bytes)}";
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { }
    }

    private void ShowMessage(string text, string type)
    {
        message = text;
        messageType = type;
    }

    private static string? NormalizeCode(string? code)
        => string.IsNullOrWhiteSpace(code) ? null : code.Trim();

    private static string Str(DataRow r, string col)
        => r.IsNull(col) ? string.Empty : r[col]?.ToString() ?? string.Empty;

    private static bool Bool(DataRow r, string col)
        => !r.IsNull(col) && Convert.ToBoolean(r[col]);

    private static int Int(DataRow r, string col)
        => r.IsNull(col) ? 0 : Convert.ToInt32(r[col]);

    private static Guid GuidVal(DataRow r, string col)
        => r.IsNull(col) ? Guid.Empty : (Guid)r[col];

    private static string FormatDate(DataRow r, string col)
        => r.IsNull(col) ? "—" : Convert.ToDateTime(r[col]).ToString("yyyy/MM/dd HH:mm");

    private static string GetStatusBadge(string status) => status switch
    {
        ScanStatus.Pending => "bg-secondary",
        ScanStatus.Processing => "bg-warning text-dark",
        ScanStatus.Done => "bg-success",
        ScanStatus.Error => "bg-danger",
        _ => "bg-secondary"
    };

    private static string GetStatusIcon(string status) => status switch
    {
        ScanStatus.Pending => "clock",
        ScanStatus.Processing => "arrow-repeat",
        ScanStatus.Done => "check-circle",
        ScanStatus.Error => "exclamation-triangle",
        _ => "question-circle"
    };

    private static string GetStatusText(string status) => status switch
    {
        ScanStatus.Pending => "در انتظار",
        ScanStatus.Processing => "در حال پردازش",
        ScanStatus.Done => "انجام شد",
        ScanStatus.Error => "خطا",
        _ => status
    };

    private static string GetRowClass(string status) => status switch
    {
        ScanStatus.Processing => "table-warning",
        ScanStatus.Done => "table-success",
        ScanStatus.Error => "table-danger",
        _ => ""
    };

    public async ValueTask DisposeAsync()
    {
        if (hub is not null) await hub.DisposeAsync();
    }
}

@page "/scan"
@page "/scan/{SoftwareCode}/{PicType}/{RelationCode}/{UserCode}"
@rendermode InteractiveServer
@layout ScanSystem.Web.Components.Layout.BlankLayout
@using System.Data
@using Microsoft.AspNetCore.SignalR.Client
@using ScanSystem.Shared
@using ScanSystem.Shared.Entities
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IScanService ScanService
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>pdd Scan | اسکن مدارک</PageTitle>

<HeadContent>
    <link rel="stylesheet" href="css/scan.css" />
</HeadContent>

@if (isScanning)
{
    <LoadingOverlay Title="در حال اسکن..." Subtitle="لطفاً سند را در اسکنر قرار دهید" />
}

<div class="scan-app" dir="rtl">
    <!-- نوار بالایی -->
    <div class="sa-toolbar">
        <div class="sa-toolbar-top">
            <h5 class="sa-title">
                <img class="sa-title-logo" src="img/pddscan-logo.png" alt="pdd Scan" />
                <span class="sa-title-text">
                    <b class="sa-title-brand">pdd Scan</b>
                    <small class="sa-title-sub">اسکن مدارک</small>
                </span>
            </h5>
            <span class="sa-pill @(isConnected ? "online" : "offline")">
                <span class="sa-dot"></span>
                @(isConnected ? "سرور متصل" : "سرور قطع")
            </span>
        </div>

        <hr class="sa-sep" />

        <div class="sa-controls">
            <div class="d-flex align-items-center gap-2">
                <span class="sa-field-label">دستگاه:</span>
                @if (agents == null)
                {
                    <select class="form-select form-select-sm sa-select" disabled>
                        <option>در حال بارگذاری...</option>
                    </select>
                }
                else if (agents.Rows.Count == 0)
                {
                    <select class="form-select form-select-sm sa-select" disabled>
                        <option>بدون Agent</option>
                    </select>
                    <small class="text-danger">ابتدا Agent را اجرا و متصل کنید.</small>
                }
                else
                {
                    <select class="form-select form-select-sm sa-select" @bind="selectedMachine" @bind:after="OnMachineChanged">
                        <option value="">— انتخاب کنید —</option>
                        @foreach (DataRow row in agents.Rows)
                        {
                            var name = Str(row, "MachineName");
                            var online = Bool(row, "IsOnline");
                            <option value="@name">
                                @name @(online ? "✓" : "✗")
                            </option>
                        }
                    </select>
                    <span class="sa-pill @(selectedOnline ? "online" : "offline")">
                        <span class="sa-dot"></span>
                        @(selectedOnline ? "آنلاین" : "آفلاین")
                    </span>
                }
            </div>

            <div class="form-check form-switch sa-switch mb-0">
                <input class="form-check-input" type="checkbox" id="chkMultiPage" @bind="multiPage" @bind:after="OnMultiPageChanged" />
                <label class="form-check-label" for="chkMultiPage">چندصفحه‌ای (ADF)</label>
            </div>

            <button class="sa-btn sa-btn-primary" @onclick="StartScan" disabled="@(!CanScan)">
                @if (isScanning)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
                else
                {
                    <i class="bi bi-camera"></i>
                }
                شروع اسکن
            </button>

            <button class="sa-btn sa-btn-ghost" @onclick="GoBack" title="بازگشت به لیست">
                <i class="bi bi-arrow-right"></i> بازگشت
            </button>
        </div>

        <!-- زمینه اسکن -->
        @if (HasScanContext)
        {
            <div class="sa-context-strip">
                <span class="sa-context-title"><i class="bi bi-link-45deg"></i> زمینه اسکن</span>
                @if (!string.IsNullOrEmpty(CurrentSoftwareCode))
                {
                    <span class="sa-context-chip">سافتور: <b>@CurrentSoftwareCode</b></span>
                }
                @if (!string.IsNullOrEmpty(CurrentPicType))
                {
                    <span class="sa-context-chip">نوع: <b>@CurrentPicType</b></span>
                }
                @if (!string.IsNullOrEmpty(CurrentRelationCode))
                {
                    <span class="sa-context-chip">ریلیشن: <b>@CurrentRelationCode</b></span>
                }
                @if (!string.IsNullOrEmpty(CurrentUserCode))
                {
                    <span class="sa-context-chip">کاربر: <b>@CurrentUserCode</b></span>
                }
            </div>
        }
    </div>

    <!-- بنر: اسکنر تنظیم نیست -->
    @if (scannerNotConfigured)
    {
        <div class="sa-scanner-missing">
            <span class="sa-icon"><i class="bi bi-exclamation-triangle-fill"></i></span>
            <div class="sa-text">
                <b>اسکنر تنظیم نیست</b>
                <span>روی دستگاه انتخاب‌شده اسکنری متصل/پیکربندی نشده است.</span>
            </div>
        </div>
    }

    <!-- پیام‌ها -->
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="sa-alert sa-alert-@messageType" role="alert">
            <i class="bi bi-@(AlertIcon)"></i>
            <span>@message</span>
            <button type="button" class="sa-alert-close" @onclick="() => message = null">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }

    <!-- اطلاعات زمینه -->
    @if (HasScanContext)
    {
        <div class="sa-card">
            <div class="sa-card-header">
                <span class="sa-card-title"><i class="bi bi-person-vcard"></i> اطلاعات اسکن</span>
            </div>
            <div class="sa-card-body">
                <div class="sa-info-grid">
                    @if (!string.IsNullOrEmpty(CurrentSoftwareCode))
                    {
                        <div class="sa-info-item">
                            <div class="sa-info-icon"><i class="bi bi-code-square"></i></div>
                            <div class="sa-info-content">
                                <span class="sa-info-label">سافتور کد</span>
                                <span class="sa-info-value">@CurrentSoftwareCode</span>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(CurrentPicType))
                    {
                        <div class="sa-info-item">
                            <div class="sa-info-icon"><i class="bi bi-tag"></i></div>
                            <div class="sa-info-content">
                                <span class="sa-info-label">نوع تصویر</span>
                                <span class="sa-info-value">@CurrentPicType</span>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(CurrentRelationCode))
                    {
                        <div class="sa-info-item">
                            <div class="sa-info-icon"><i class="bi bi-link-45deg"></i></div>
                            <div class="sa-info-content">
                                <span class="sa-info-label">ریلیشن کد</span>
                                <span class="sa-info-value">@CurrentRelationCode</span>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(CurrentUserCode))
                    {
                        <div class="sa-info-item">
                            <div class="sa-info-icon"><i class="bi bi-person"></i></div>
                            <div class="sa-info-content">
                                <span class="sa-info-label">کد کاربر</span>
                                <span class="sa-info-value">@CurrentUserCode</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- گالری تصاویر -->
    <ScanGallery Hub="@hub"
                 SoftwareCode="@CurrentSoftwareCode"
                 PicType="@CurrentPicType"
                 RelationCode="@CurrentRelationCode"
                 OnMessage="@(m => ShowMessage(m.Text, m.Type))" />
</div>

@code {
    private HubConnection? hub;

    // مسیر: /scan/{SoftwareCode}/{PicType}/{RelationCode}/{UserCode}
    [Parameter] public string? SoftwareCode { get; set; }
    [Parameter] public string? PicType { get; set; }
    [Parameter] public string? RelationCode { get; set; }
    [Parameter] public string? UserCode { get; set; }

    // Settings
    private DataTable? agents;
    private string selectedMachine = "";
    private bool multiPage = true;
    private bool isConnected = false;
    private bool isScanning = false;
    private bool scannerNotConfigured = false;
    private bool initialized = false;

    // Messages
    private string? message;
    private string messageType = "info";

    private bool selectedOnline => !string.IsNullOrEmpty(selectedMachine) &&
        agents?.Rows.Cast<DataRow>().Any(r => Str(r, "MachineName") == selectedMachine && Bool(r, "IsOnline")) == true;

    private bool CanScan => isConnected && !isScanning && !string.IsNullOrEmpty(selectedMachine) && selectedOnline;

    private string? CurrentSoftwareCode => NormalizeCode(SoftwareCode);
    private string? CurrentPicType => NormalizeCode(PicType);
    private string? CurrentRelationCode => NormalizeCode(RelationCode);
    private string? CurrentUserCode => NormalizeCode(UserCode);
    private bool HasScanContext => CurrentSoftwareCode is not null || CurrentPicType is not null || CurrentRelationCode is not null || CurrentUserCode is not null;

    private string AlertIcon => messageType switch
    {
        "success" => "check-circle",
        "danger" => "exclamation-triangle",
        "warning" => "exclamation-circle",
        _ => "info-circle"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
        await LoadAgents();
        initialized = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        // اگر پارامترهای مسیر تغییر کرد، StateHasChanged فراخوانی شود
        // تا اطلاعات جدید نمایش داده شود
        if (initialized) StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await ConnectHub();
        StateHasChanged();
    }

    // ───────────────────────── SignalR ─────────────────────────

    private async Task ConnectHub()
    {
        hub = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/scanhub"))
            .WithAutomaticReconnect()
            .Build();

        hub.On("AgentsChanged", async () => await InvokeAsync(async () =>
        {
            await LoadAgents();
            StateHasChanged();
        }));

        hub.On<string, bool>("AgentStatusChanged", async (_, _) => await InvokeAsync(async () =>
        {
            await LoadAgents();
            StateHasChanged();
        }));

        hub.On<List<AgentDto>>("AgentsList", async (list) => await InvokeAsync(async () =>
        {
            await LoadAgents();
            StateHasChanged();
        }));

        hub.On<Guid>("ScanCompleted", async (id) => await InvokeAsync(() =>
        {
            isScanning = false;
            scannerNotConfigured = false;
            ShowMessage("اسکن با موفقیت انجام شد.", "success");
            StateHasChanged();
        }));

        // «GalleryChanged» و «GroupsChanged» مستقیماً توسط خود کامپوننت ScanGallery مدیریت می‌شوند.

        hub.On<Guid, string>("StatusChanged", async (id, status) => await InvokeAsync(() =>
        {
            if (status == ScanStatus.Error)
            {
                isScanning = false;
            }
            StateHasChanged();
        }));

        hub.On<Guid, string>("ScanError", async (id, errorMessage) => await InvokeAsync(() =>
        {
            isScanning = false;
            if (!string.IsNullOrWhiteSpace(errorMessage) && errorMessage.Contains("اسکنر تنظیم نیست", StringComparison.Ordinal))
            {
                scannerNotConfigured = true;
                ShowMessage("اسکنر تنظیم نیست.", "danger");
            }
            else
            {
                scannerNotConfigured = false;
                ShowMessage($"اسکن با خطا مواجه شد: {errorMessage}", "danger");
            }
            StateHasChanged();
        }));

        hub.Closed += async _ => { isConnected = false; await InvokeAsync(StateHasChanged); };
        hub.Reconnected += _ => { isConnected = true; return Task.CompletedTask; };

        try
        {
            await hub.StartAsync();
            isConnected = true;
        }
        catch (Exception ex)
        {
            ShowMessage($"خطا در اتصال به سرور: {ex.Message}", "danger");
        }
    }

    // ───────────────────────── Settings ─────────────────────────

    private async Task LoadSettings()
    {
        try
        {
            var machine = await JS.InvokeAsync<string?>("localStorage.getItem", "scan.selectedMachine");
            var mp = await JS.InvokeAsync<string?>("localStorage.getItem", "scan.multiPage");
            if (!string.IsNullOrEmpty(machine)) selectedMachine = machine;
            if (bool.TryParse(mp, out var parsed)) multiPage = parsed;
        }
        catch { }
    }

    private async Task SaveMachineSetting()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "scan.selectedMachine", selectedMachine);
        }
        catch { }
    }

    private async Task SaveMultiPageSetting()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "scan.multiPage", multiPage.ToString());
        }
        catch { }
    }

    private async Task OnMachineChanged()
    {
        scannerNotConfigured = false;
        await SaveMachineSetting();
    }

    private async Task OnMultiPageChanged()
    {
        await SaveMultiPageSetting();
    }

    // ───────────────────────── Data Loading ─────────────────────────

    private async Task LoadAgents()
    {
        try
        {
            agents = await ScanService.GetAgentsDataTableAsync();

            if (string.IsNullOrEmpty(selectedMachine) ||
                !agents.Rows.Cast<DataRow>().Any(r => Str(r, "MachineName") == selectedMachine))
            {
                var firstOnline = agents.Rows.Cast<DataRow>().FirstOrDefault(r => Bool(r, "IsOnline"));
                if (firstOnline != null)
                {
                    selectedMachine = Str(firstOnline, "MachineName");
                    await SaveMachineSetting();
                }
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"خطا در بارگذاری Agentها: {ex.Message}", "danger");
            agents = new DataTable();
        }
    }

    // ───────────────────────── Scan ─────────────────────────

    private async Task StartScan()
    {
        if (hub == null || !CanScan) return;

        isScanning = true;
        scannerNotConfigured = false;
        ShowMessage("درخواست اسکن ارسال شد...", "info");
        try
        {
            await hub.InvokeAsync("RequestScanWithContext", selectedMachine, multiPage,
                CurrentSoftwareCode, CurrentPicType, CurrentRelationCode, CurrentUserCode);
        }
        catch (Exception ex)
        {
            isScanning = false;
            ShowMessage($"خطا در ارسال درخواست: {ex.Message}", "danger");
        }
    }

    // ───────────────────────── Navigation ─────────────────────────

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }

    // ───────────────────────── Helpers ─────────────────────────

    private void ShowMessage(string text, string type)
    {
        message = text;
        messageType = type;
    }

    // «-» به عنوان جای‌نگهدار پارامتر خالی در مسیر استفاده می‌شود (مثل /scan/-/-/REL-1/-)
    private static string? NormalizeCode(string? code)
    {
        if (string.IsNullOrWhiteSpace(code) || code.Trim() == "-") return null;
        return code.Trim();
    }

    private static string Str(DataRow r, string col)
        => r.IsNull(col) ? string.Empty : r[col]?.ToString() ?? string.Empty;

    private static bool Bool(DataRow r, string col)
        => !r.IsNull(col) && Convert.ToBoolean(r[col]);

    public async ValueTask DisposeAsync()
    {
        if (hub is not null) await hub.DisposeAsync();
    }
}

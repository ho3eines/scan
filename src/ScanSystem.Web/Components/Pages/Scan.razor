@page "/scan"
@rendermode InteractiveServer
@using System.Data
@using Microsoft.AspNetCore.SignalR.Client
@using ScanSystem.Shared
@using ScanSystem.Shared.Entities
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IScanService ScanService

<PageTitle>مدیریت اسکن</PageTitle>

@if (isScanning)
{
    <LoadingOverlay Title="در حال اسکن..." Subtitle="لطفاً سند را در اسکنر قرار دهید" />
}

<div class="container-fluid mt-3" dir="rtl">
    <!-- هدر -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body py-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0">
                                <i class="bi bi-camera-fill text-primary"></i>
                                مدیریت اسکن مدارک
                            </h5>
                        </div>
                        <div>
                            @if (isConnected)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-wifi"></i> آنلاین
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    <i class="bi bi-wifi-off"></i> آفلاین
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- پیام‌ها -->
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="row mb-3">
            <div class="col-12">
                <div class="alert alert-@messageType alert-dismissible fade show" role="alert">
                    <i class="bi bi-@(messageType == "success" ? "check-circle" : messageType == "danger" ? "exclamation-triangle" : "info-circle")"></i>
                    @message
                    <button type="button" class="btn-close" @onclick="() => message = null"></button>
                </div>
            </div>
        </div>
    }

    <div class="row">
        <!-- پنل کنترل -->
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-dark text-white">
                    <i class="bi bi-gear"></i> کنترل اسکن
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">انتخاب دستگاه (Agent)</label>
                        @if (agents == null)
                        {
                            <select class="form-control" disabled>
                                <option>در حال بارگذاری...</option>
                            </select>
                        }
                        else if (agents.Count == 0)
                        {
                            <select class="form-control" disabled>
                                <option>هیچ Agentی ثبت نشده است</option>
                            </select>
                            <div class="form-text text-danger small mt-1">
                                <i class="bi bi-exclamation-triangle"></i>
                                ابتدا Agent را روی دستگاه کلاینت اجرا و متصل کنید.
                            </div>
                        }
                        else
                        {
                            <select class="form-control" @bind="selectedMachine">
                                <option value="">— انتخاب کنید —</option>
                                @foreach (var a in agents)
                                {
                                    <option value="@a.MachineName">
                                        @a.MachineName — @(a.IsOnline ? "آنلاین" : "آفلاین")
                                    </option>
                                }
                            </select>
                            <div class="form-text small mt-1">
                                <span class="badge @(isConnected ? "bg-success" : "bg-secondary")">
                                    @(agents.Count(x => x.IsOnline)) Agent آنلاین
                                </span>
                            </div>
                        }
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="chkMultiPage" @bind="multiPage" />
                        <label class="form-check-label" for="chkMultiPage">
                            اسکن چندصفحه‌ای (ADF/Feeder)
                        </label>
                        <div class="form-text small">
                            با فعال بودن این گزینه، Agent تا پایان کاغذ داخل Feeder اسکن می‌کند
                            و هر صفحه را به‌محض آماده شدن ارسال می‌کند.
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button class="btn btn-success btn-lg" @onclick="StartScan"
                                disabled="@(!isConnected || isScanning || string.IsNullOrEmpty(selectedMachine))">
                            @if (isScanning)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>در حال اسکن...</span>
                            }
                            else
                            {
                                <i class="bi bi-camera me-2"></i>
                                <span>شروع اسکن</span>
                            }
                        </button>

                        <button class="btn btn-outline-primary" @onclick="LoadAll">
                            <i class="bi bi-arrow-clockwise me-2"></i>
                            بروزرسانی
                        </button>
                    </div>

                    <hr />

                    <div class="text-muted small">
                        <i class="bi bi-info-circle"></i>
                        وضعیت اتصال به سرور:
                        @if (isConnected)
                        {
                            <span class="text-success">متصل</span>
                        }
                        else
                        {
                            <span class="text-danger">قطع</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- جدول درخواست‌ها (خروجی System.Data.DataTable — پیمایش DataRow) -->
        <div class="col-md-8 mb-3">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white d-flex justify-content-between">
                    <span><i class="bi bi-list-ul"></i> آخرین درخواست‌های اسکن</span>
                    <span class="badge bg-light text-dark">@(requests?.Rows.Count ?? 0)</span>
                </div>
                <div class="card-body">
                    @if (requests == null)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">در حال بارگذاری...</span>
                            </div>
                            <p class="mt-2 text-muted">در حال بارگذاری...</p>
                        </div>
                    }
                    else if (requests.Rows.Count == 0)
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox display-1 text-muted"></i>
                            <p class="mt-3 text-muted">هنوز درخواست اسکنی ثبت نشده است.</p>
                            <p class="text-muted small">روی دکمه «شروع اسکن» کلیک کنید.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-striped align-middle data-row-table">
                                <thead class="table-dark">
                                    <tr>
                                        <th style="width: 50px">#</th>
                                        <th>شناسه</th>
                                        <th>ایستگاه کاری</th>
                                        <th>نوع</th>
                                        <th>وضعیت</th>
                                        <th>صفحات</th>
                                        <th>تاریخ ایجاد</th>
                                        <th>تاریخ تکمیل</th>
                                        <th style="width: 160px">عملیات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int rowIndex = 0; }
                                    @foreach (DataRow row in requests.Rows)
                                    {
                                        rowIndex++;
                                        var status = Str(row, "Status");
                                        var id = GuidVal(row, "Id");
                                        var imageCount = Int(row, "ImageCount");
                                        <tr class="@GetRowClass(status)">
                                            <td>@rowIndex</td>
                                            <td>
                                                <code class="small">@id.ToString()[..8]</code>
                                            </td>
                                            <td>@Str(row, "MachineName")</td>
                                            <td>
                                                @if (Bool(row, "IsMultiPage"))
                                                {
                                                    <span class="badge bg-info text-dark">چندصفحه‌ای</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-dark border">تک‌صفحه</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge @GetStatusBadge(status)">
                                                    <i class="bi bi-@(GetStatusIcon(status))"></i>
                                                    @GetStatusText(status)
                                                </span>
                                            </td>
                                            <td><span class="badge bg-secondary">@imageCount</span></td>
                                            <td class="small">@FormatDate(row, "CreatedAt")</td>
                                            <td class="small">
                                                @if (row.IsNull("CompletedAt"))
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                                else
                                                {
                                                    @FormatDate(row, "CompletedAt")
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    @if (status == ScanStatus.Done && imageCount > 0)
                                                    {
                                                        <button class="btn btn-outline-info" title="پیش‌نمایش صفحه اول"
                                                                @onclick="() => ShowPreview(id)">
                                                            <i class="bi bi-zoom-in"></i>
                                                        </button>
                                                    }
                                                    <button class="btn btn-outline-danger" title="حذف"
                                                            @onclick="() => DeleteRequest(id)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="text-muted small mt-2">
                            <i class="bi bi-table"></i>
                            برای جستجو، صفحه‌بندی و مرتب‌سازی پیشرفته به صفحه
                            <a href="/requests">درخواست‌های اسکن</a> مراجعه کنید.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- پیش‌نمایش تصویر -->
    @if (previewImageUrl != null)
    {
        <div class="row mt-3">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-info text-white d-flex justify-content-between">
                        <span><i class="bi bi-image"></i> پیش‌نمایش صفحه اول</span>
                        <button class="btn btn-sm btn-outline-light" @onclick="ClosePreview">
                            <i class="bi bi-x-lg"></i> بستن
                        </button>
                    </div>
                    <div class="card-body text-center">
                        @if (previewLoading)
                        {
                            <Skeleton Variant="image" />
                        }
                        <img src="@previewImageUrl" class="scan-preview-img img-fluid"
                             style="@(previewLoading ? "display:none" : "")"
                             alt="پیش‌نمایش اسکن" @onload="OnPreviewLoaded" />
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private HubConnection? hubConnection;
    private DataTable? requests; // خروجی Dapper به‌صورت System.Data.DataTable (§6.6)
    private List<AgentDto>? agents;
    private string selectedMachine = "";
    private bool multiPage = true;
    private bool isConnected = false;
    private bool isScanning = false;
    private string? message;
    private string messageType = "info";
    private string? previewImageUrl;
    private bool previewLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadRequests();
        await LoadAgents();
        await ConnectToHub();
    }

    private async Task LoadAgents()
    {
        try { agents = await ScanService.GetAgentsAsync(); }
        catch { agents = new List<AgentDto>(); }

        // اگر دستگاه انتخاب‌شده دیگر در لیست نیست یا هنوز چیزی انتخاب نشده، اولین Agent آنلاین را پیش‌فرض می‌گیریم.
        if (agents is not null)
        {
            if (string.IsNullOrEmpty(selectedMachine) || !agents.Any(a => a.MachineName == selectedMachine))
            {
                var firstOnline = agents.FirstOrDefault(a => a.IsOnline);
                if (firstOnline is not null) selectedMachine = firstOnline.MachineName;
            }
        }
    }

    private async Task LoadRequests()
    {
        try { requests = await ScanService.GetRecentRequestsDataTableAsync(50); }
        catch { requests = new DataTable(); }
    }

    private async Task LoadAll()
    {
        await LoadRequests();
        await LoadAgents();
    }

    private async Task ConnectToHub()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/scanhub"))
            .WithAutomaticReconnect()
            .Build();

        // لیست درخواست‌ها عوض شد → بازخوانی جدول.
        hubConnection.On("RequestsChanged", async () =>
        {
            await InvokeAsync(async () =>
            {
                await LoadRequests();
                StateHasChanged();
            });
        });

        // هر بار که Agentای ثبت/قطع شد، لیست دستگاه‌ها را بازخوانی می‌کنیم.
        hubConnection.On("AgentsChanged", async () =>
        {
            await InvokeAsync(async () =>
            {
                await LoadAgents();
                StateHasChanged();
            });
        });

        hubConnection.On<string, bool>("AgentStatusChanged", async (machineName, online) =>
        {
            await InvokeAsync(async () =>
            {
                await LoadAgents();
                StateHasChanged();
            });
        });

        hubConnection.On<List<AgentDto>>("AgentsList", async (list) =>
        {
            await InvokeAsync(async () =>
            {
                agents = list;
                await LoadAgents(); // برای پیش‌فرض‌گذاری انتخاب
                StateHasChanged();
            });
        });

        // پایان موفق اسکن (Hub فقط شناسه درخواست را می‌فرستد).
        hubConnection.On<Guid>("ScanCompleted", async (requestId) =>
        {
            await InvokeAsync(async () =>
            {
                message = $"اسکن با موفقیت انجام شد! (شناسه: {requestId.ToString()[..8]})";
                messageType = "success";
                isScanning = false;
                await LoadRequests();
                StateHasChanged();
            });
        });

        hubConnection.On<Guid, string>("StatusChanged", async (requestId, status) =>
        {
            await InvokeAsync(async () =>
            {
                if (status == ScanStatus.Error)
                {
                    message = "اسکن با خطا مواجه شد. لاگ Agent را بررسی کنید.";
                    messageType = "danger";
                    isScanning = false;
                }
                await LoadRequests();
                StateHasChanged();
            });
        });

        hubConnection.Closed += async _ =>
        {
            isConnected = false;
            await InvokeAsync(StateHasChanged);
        };

        hubConnection.Reconnected += _ =>
        {
            isConnected = true;
            return Task.CompletedTask;
        };

        try
        {
            await hubConnection.StartAsync();
            isConnected = true;
        }
        catch (Exception ex)
        {
            message = $"خطا در اتصال به سرور: {ex.Message}";
            messageType = "danger";
        }

        StateHasChanged();
    }

    private async Task StartScan()
    {
        if (hubConnection is null || !isConnected) return;
        if (string.IsNullOrWhiteSpace(selectedMachine))
        {
            message = "ابتدا یک دستگاه (Agent) را انتخاب کنید.";
            messageType = "danger";
            StateHasChanged();
            return;
        }

        var machine = selectedMachine;
        isScanning = true;
        message = $"درخواست اسکن برای «{machine}» ارسال شد...";
        messageType = "info";
        StateHasChanged();

        try
        {
            // Hub همیشه هر دو آرگومان را دریافت می‌کند (machineName, isMultiPage).
            await hubConnection.InvokeAsync("RequestScan", machine, multiPage);
        }
        catch (Exception ex)
        {
            message = $"خطا در ارسال درخواست: {ex.Message}";
            messageType = "danger";
            isScanning = false;
        }

        StateHasChanged();
    }

    private async Task DeleteRequest(Guid id)
    {
        try
        {
            await ScanService.DeleteRequestAsync(id);
            await LoadRequests();
            message = "درخواست با موفقیت حذف شد.";
            messageType = "warning";
        }
        catch (Exception ex)
        {
            message = $"خطا در حذف: {ex.Message}";
            messageType = "danger";
        }
    }

    private void ShowPreview(Guid requestId)
    {
        previewLoading = true;
        // صفحه اول یک درخواست؛ ts برای جلوگیری از کش مرورگر.
        previewImageUrl = $"/api/request/{requestId}/page/1?ts={DateTime.Now.Ticks}";
    }

    private void OnPreviewLoaded()
    {
        previewLoading = false;
        StateHasChanged();
    }

    private void ClosePreview()
    {
        previewImageUrl = null;
        previewLoading = false;
    }

    private string GetStatusBadge(string status) => status switch
    {
        ScanStatus.Pending => "bg-secondary",
        ScanStatus.Processing => "bg-warning text-dark",
        ScanStatus.Done => "bg-success",
        ScanStatus.Error => "bg-danger",
        _ => "bg-secondary"
    };

    private string GetStatusIcon(string status) => status switch
    {
        ScanStatus.Pending => "clock",
        ScanStatus.Processing => "arrow-repeat",
        ScanStatus.Done => "check-circle",
        ScanStatus.Error => "exclamation-triangle",
        _ => "question-circle"
    };

    private string GetStatusText(string status) => status switch
    {
        ScanStatus.Pending => "در انتظار",
        ScanStatus.Processing => "در حال پردازش",
        ScanStatus.Done => "انجام شد",
        ScanStatus.Error => "خطا",
        _ => status
    };

    private string GetRowClass(string status) => status switch
    {
        ScanStatus.Processing => "table-warning",
        ScanStatus.Done => "table-success",
        ScanStatus.Error => "table-danger",
        _ => ""
    };

    // ─────────── helpers برای خواندن امن DataRow ───────────

    private static string Str(DataRow r, string col)
        => r.IsNull(col) ? "—" : r[col]?.ToString() ?? "—";

    private static bool Bool(DataRow r, string col)
        => !r.IsNull(col) && Convert.ToBoolean(r[col]);

    private static int Int(DataRow r, string col)
        => r.IsNull(col) ? 0 : Convert.ToInt32(r[col]);

    private static Guid GuidVal(DataRow r, string col)
        => Guid.Parse(r[col].ToString()!);

    private static string FormatDate(DataRow r, string col)
        => r.IsNull(col) ? "—" : Convert.ToDateTime(r[col]).ToString("yyyy/MM/dd HH:mm");

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}

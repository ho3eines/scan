@page "/"

<PageTitle>خانه</PageTitle>

<div class="container mt-4" dir="rtl">
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">سیستم اسکن مدارک</h4>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-4 mb-3">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h5 class="card-title text-primary">
                                        <i class="bi bi-camera"></i>
                                    </h5>
                                    <h6 class="card-subtitle mb-2 text-muted">اسکن مدارک</h6>
                                    <p class="card-text">شروع اسکن جدید و مدیریت درخواست‌ها</p>
                                    <a href="/scan" class="btn btn-primary">برو به اسکن</a>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h5 class="card-title text-success">
                                        <i class="bi bi-hdd"></i>
                                    </h5>
                                    <h6 class="card-subtitle mb-2 text-muted">ذخیره‌سازی</h6>
                                    <p class="card-text">ذخیره امن تصاویر باینری در SQL Server</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h5 class="card-title text-warning">
                                        <i class="bi bi-wifi"></i>
                                    </h5>
                                    <h6 class="card-subtitle mb-2 text-muted">ارتباط زنده</h6>
                                    <p class="card-text">ارتباط لحظه‌ای با SignalR</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

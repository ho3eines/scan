<Window x:Class="ScanSystem.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScanSystem Agent" Height="560" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- هدر -->
        <TextBlock Grid.Row="0" Text="اسکنر مدارک" FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- اتصال -->
        <GroupBox Grid.Row="1" Header="تنظیمات اتصال" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="آدرس سرور:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" x:Name="txtServerUrl" Text="http://localhost:5002/scanhub"
                         VerticalAlignment="Center"/>
                <Button Grid.Column="2" x:Name="btnConnect" Content="اتصال"
                        Click="BtnConnect_Click" Width="80" Margin="10,0,0,0"/>
            </Grid>
        </GroupBox>

        <!-- وضعیت -->
        <GroupBox Grid.Row="2" Header="وضعیت" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="txtStatus" Text="آفلاین" Foreground="Red" FontWeight="Bold"/>
                <Grid Margin="0,3,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="txtScanner" Text="" Foreground="Gray" FontSize="11"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Grid.Column="1" x:Name="btnScannerSettings" Content="تنظیمات اسکنر"
                            Click="BtnScannerSettings_Click" Padding="6,2" FontSize="11" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock x:Name="txtLastScan" Text="" Foreground="Gray" Margin="0,3,0,0" FontSize="11"/>
            </StackPanel>
        </GroupBox>

        <!-- لاگ -->
        <GroupBox Grid.Row="3" Header="لاگ رویدادها" Margin="0,0,0,10">
            <TextBox x:Name="txtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
        </GroupBox>

        <!-- دکمه اسکن دستی -->
        <Button Grid.Row="4" x:Name="btnScan" Content="اسکن دستی (تک‌صفحه)" Height="45"
                FontSize="14" FontWeight="Bold" Click="BtnScan_Click"
                IsEnabled="False" Background="#28a745" Foreground="White"/>
    </Grid>
</Window>

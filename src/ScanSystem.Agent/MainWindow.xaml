<Window x:Class="ScanSystem.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="pdd Scan" Height="685" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        Icon="appicon.ico"
        Background="#F4F6FB">

    <Window.Resources>
        <!-- کارت سفید با گوشه گرد و سایه ملایم -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" Opacity="0.06" BlurRadius="18" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- عنوان بالای هر کارت -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- قالب پایه دکمه‌ها (گرد + افکت هاور) -->
        <Style x:Key="PddButtonBase" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PddPrimaryButton" TargetType="Button" BasedOn="{StaticResource PddButtonBase}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="PddGhostButton" TargetType="Button" BasedOn="{StaticResource PddButtonBase}">
            <Setter Property="Background" Value="#EEF2F8"/>
            <Setter Property="Foreground" Value="#1D4ED8"/>
        </Style>

        <!-- ورودی متن مدرن -->
        <Style x:Key="PddTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="White" BorderBrush="#D4DCE8" BorderThickness="1"
                                CornerRadius="9" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2563EB" TargetName="bd"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- جعبه لاگ -->
        <Style x:Key="PddLogBox" TargetType="TextBox" BasedOn="{StaticResource PddTextBox}">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="9" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- هدر: لوگو + برند -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Image Source="logo.png" Width="48" Height="48" Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="pdd Scan" FontSize="21" FontWeight="Bold" Foreground="#1D4ED8"/>
                <TextBlock Text="ایجنت اسکن مدارک — ایستگاه کاری" FontSize="12" Foreground="#64748B"/>
            </StackPanel>
        </StackPanel>

        <!-- کارت اتصال -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="اتصال به سرور" Style="{StaticResource CardTitle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="txtServerUrl" Text="http://localhost:5002/scanhub"
                             Style="{StaticResource PddTextBox}"
                             FlowDirection="LeftToRight" TextAlignment="Left"
                             VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="btnConnect" Content="اتصال"
                            Style="{StaticResource PddPrimaryButton}"
                            Click="BtnConnect_Click" MinWidth="92" Margin="10,0,0,0"/>
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="تایم‌اوت سرور (مهلت پاسخ‌دهی):"
                               Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="txtServerTimeout" Text="120"
                             Style="{StaticResource PddTextBox}" Width="68"
                             FlowDirection="LeftToRight" TextAlignment="Center"
                             VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <TextBlock Grid.Column="2" Text="ثانیه"
                               Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- کارت وضعیت -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="وضعیت ایجنت" Style="{StaticResource CardTitle}"/>

                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="statusDot" Width="10" Height="10" Fill="#DC2626"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="txtStatus" Text="آفلاین" Foreground="#DC2626"
                               FontWeight="Bold" FontSize="15"/>
                </StackPanel>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="txtScanner" Text="" Foreground="#64748B" FontSize="11.5"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Grid.Column="1" x:Name="btnScannerSettings" Content="تنظیمات (اسکنر و اتصال)"
                            Style="{StaticResource PddGhostButton}"
                            Click="BtnScannerSettings_Click" Padding="10,6" FontSize="11.5" Margin="10,0,0,0"/>
                </Grid>

                <TextBlock x:Name="txtLastScan" Text="" Foreground="#94A3B8" Margin="0,8,0,0" FontSize="11.5"/>
            </StackPanel>
        </Border>

        <!-- کارت لاگ -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="لاگ رویدادها" Style="{StaticResource CardTitle}"/>
                <TextBox Grid.Row="1" x:Name="txtLog" IsReadOnly="True"
                         Style="{StaticResource PddLogBox}"
                         VerticalScrollBarVisibility="Auto"
                         FlowDirection="LeftToRight" TextAlignment="Left"
                         TextWrapping="Wrap"/>
            </Grid>
        </Border>

    </Grid>
</Window>

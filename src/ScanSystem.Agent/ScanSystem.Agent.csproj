<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <!-- برای آیکون Tray از System.Windows.Forms.NotifyIcon استفاده می‌شود -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- آیکون برنامه (فایل exe + نوار عنوان پنجره‌ها) -->
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <AssemblyName>ScanSystem.Agent</AssemblyName>
    <RootNamespace>ScanSystem.Agent</RootNamespace>
    <Version>1.0.0</Version>
    <Product>pdd Scan</Product>
    <Title>pdd Scan</Title>
    <Description>pdd Scan — ایجنت محلی اسکن مدارک روی ایستگاه کاری</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- فایل‌های آیکون/لوگو داخل اسمبلی Resource می‌شوند تا در XAML و Tray قابل استفاده باشند -->
    <Resource Include="appicon.ico" />
    <Resource Include="logo.png" />
    <None Remove="appicon.ico" />
    <None Remove="logo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- کلاینت SignalR برای ارتباط با Hub سرور -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.10" />
    <!-- ساخت تصویر شبیه‌سازی‌شده روی Windows -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScanSystem.Shared\ScanSystem.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="agentsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- برای آیکون Tray از System.Windows.Forms.NotifyIcon استفاده می‌شود -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ScanSystem.Agent</AssemblyName>
    <RootNamespace>ScanSystem.Agent</RootNamespace>
    <Version>1.0.0</Version>
    <Product>ScanSystem Agent</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- کلاینت SignalR برای ارتباط با Hub سرور -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.10" />
    <!-- ساخت تصویر شبیه‌سازی‌شده روی Windows -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScanSystem.Shared\ScanSystem.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="agentsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

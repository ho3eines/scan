<Window x:Class="ScanSystem.Agent.ScannerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="pdd Scan — تنظیمات اسکنر" Height="540" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        Icon="appicon.ico"
        Background="#F4F6FB">

    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" Opacity="0.06" BlurRadius="18" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PddButtonBase" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PddPrimaryButton" TargetType="Button" BasedOn="{StaticResource PddButtonBase}">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="PddGhostButton" TargetType="Button" BasedOn="{StaticResource PddButtonBase}">
            <Setter Property="Background" Value="#EEF2F8"/>
            <Setter Property="Foreground" Value="#1D4ED8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- هدر -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Image Source="logo.png" Width="36" Height="36" Margin="0,0,10,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="تنظیمات اسکنر" FontSize="17" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="اسکنر مورد استفاده این ایستگاه کاری را انتخاب کنید" FontSize="11.5" Foreground="#64748B"/>
            </StackPanel>
        </StackPanel>

        <!-- کارت انتخاب اسکنر -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="اسکنرهایی که Windows/WIA شناسایی کرده است:"
                               Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="btnRefresh" Content="به‌روزرسانی لیست"
                            Style="{StaticResource PddGhostButton}" Padding="10,6" FontSize="11.5"
                            Click="BtnRefresh_Click" Margin="10,0,0,0"/>
                </Grid>

                <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Background="#F8FAFC">
                    <ListBox x:Name="lstScanners" BorderThickness="0" Background="Transparent" Margin="2">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding Name}"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                             GroupName="scanners" Margin="4,7" FontSize="12.5"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <TextBlock Grid.Row="2" x:Name="txtNoScanner" Text="هیچ اسکنری شناسایی نشد."
                           Foreground="#DC2626" FontSize="12" Margin="0,8,0,0"
                           Visibility="Collapsed" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- کارت گزینه‌ها -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="گزینه‌های رفتاری" Style="{StaticResource CardTitle}"/>
                <CheckBox x:Name="chkPlaceholder" Content="در صورت نبود اسکنر، تصویر آزمایشی (Placeholder) بسازد"
                          Margin="0,0,0,6" FontSize="12.5"/>
                <TextBlock Text="اگر غیرفعال باشد، در نبود اسکنر به سرور «اسکنر تنظیم نیست» گزارش می‌شود و تصویری ارسال نمی‌گردد."
                           Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="24,-4,0,10"/>
                <CheckBox x:Name="chkSkipBlank" Content="صفحات کاملاً سفید/خالی به سرور ارسال نشوند"
                          FontSize="12.5"/>
            </StackPanel>
        </Border>

        <!-- دکمه‌ها -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
            <Button x:Name="btnSave" Content="ذخیره" MinWidth="110" Height="40"
                    Style="{StaticResource PddPrimaryButton}" Click="BtnSave_Click" Margin="0,0,10,0"/>
            <Button x:Name="btnCancel" Content="انصراف" MinWidth="110" Height="40"
                    Style="{StaticResource PddGhostButton}" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="ScanSystem.Agent.ScannerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تنظیمات اسکنر" Height="480" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="تنظیمات اسکنر" FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="اسکنرهایی که Windows/WIA شناسایی کرده است. اسکنر مورد نظر را انتخاب کنید:"
                       TextWrapping="Wrap" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="btnRefresh" Content="به‌روزرسانی لیست" Click="BtnRefresh_Click"
                    Margin="10,0,0,0" Padding="8,4"/>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#ddd" BorderThickness="1" CornerRadius="4">
            <ListBox x:Name="lstScanners" BorderThickness="0" Margin="2">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                     GroupName="scanners" Margin="4,6" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Grid.Row="3" x:Name="txtNoScanner" Text="هیچ اسکنری شناسایی نشد."
                   Foreground="#c0392b" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <CheckBox x:Name="chkPlaceholder" Content="در صورت نبود اسکنر، تصویر آزمایشی (Placeholder) بسازد"
                      Margin="0,0,0,8"/>
            <TextBlock Text="در صورت غیرفعال بودن این گزینه، اگر اسکنری وصل نباشد، به سرور اعلام می‌شود «اسکنر تنظیم نیست» و هیچ تصویری ارسال نمی‌شود."
                       Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="22,-6,0,10"/>

            <CheckBox x:Name="chkSkipBlank" Content="اگر صفحه اسکن‌شده کاملاً سفید/خالی بود، به سرور ارسال نشود"
                      Margin="0,0,0,4"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,15,0,0">
            <Button x:Name="btnSave" Content="ذخیره" Width="90" Height="32" Click="BtnSave_Click"
                    Background="#28a745" Foreground="White" Margin="0,0,8,0"/>
            <Button x:Name="btnCancel" Content="انصراف" Width="90" Height="32" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
